  <script>
  (function () {
    /**
     * Hook into the calculate estimate button and append stone/bracket rows
     * for types 2, 4 and 5. This script runs once on page load.
     */
    function mmToMeters(mm) {
      return (mm / 1000).toFixed(2);
    }

    // Retrieve key parameters from the UI
    function readStoneBracketParams() {
      const kindSelect = document.getElementById('kind_simple');
      const kind = kindSelect ? kindSelect.value : '';
      // Width and thickness of trim: per-type fields or manual fallbacks
      let C = 0;
      let T = 0;
      function valById(id) {
        const el = document.getElementById(id);
        if (el && el.value) {
          const v = parseFloat(el.value);
          if (!isNaN(v)) return v;
        }
        return null;
      }
      // get C and T based on type
      if (kind === 'type2') {
        C = valById('type2_trim_width');
        T = valById('type2_trim_thickness');
      } else if (kind === 'type4') {
        C = valById('type4_trim_width');
        T = valById('type4_trim_thickness');
      } else if (kind === 'type5') {
        C = valById('type5_trim_width');
        T = valById('type5_trim_thickness');
      }
      // fallback to manual values
      if (!C || isNaN(C)) C = valById('manual_trim_width');
      if (!T || isNaN(T)) T = valById('manual_trim_thickness');

      // Stone height F and bracket height G
      let F = 0, G = 0;
      if (kind === 'type2') {
        F = valById('type2_stone_height');
      } else if (kind === 'type4') {
        F = valById('type4_stone_height');
      } else if (kind === 'type5') {
        F = valById('type5_stone_height');
        G = valById('type5_bracket_height');
      }
      // Number of openings: default 1
      let count = parseFloat(valById('openings_count')) || 1;
      return { kind, C: C || 0, T: T || 0, F: F || 0, G: G || 0, count };
    }

    function findCalcButton() {
      // Try by id
      let btn = document.getElementById('btn_calc_estimate');
      if (btn) return btn;
      // fallback: search by text content
      const buttons = document.querySelectorAll('button, input[type="button"], input[type="submit"]');
      for (const b of buttons) {
        const text = (b.value || b.innerText || '').trim().toLowerCase();
        if (text.includes('рассчитать смету')) return b;
      }
      return null;
    }

    function findEstimateBody() {
      // Try known id
      let tbody = document.getElementById('estimate_body');
      if (tbody) return tbody;
      // fallback: search inside section with "Профессиональная смета"
      const sections = document.querySelectorAll('*');
      for (const sec of sections) {
        const txt = (sec.innerText || '').trim();
        if (txt && txt.includes('Профессиональная смета')) {
          const table = sec.querySelector('table');
          if (table) {
            const body = table.querySelector('tbody') || table;
            if (body) return body;
          }
        }
      }
      return null;
    }

    function removeExistingRows(tbody) {
      const rows = [...tbody.querySelectorAll('tr')];
      for (const row of rows) {
        const cellText = (row.innerText || '').toLowerCase();
        if (cellText.includes('камни (вставки)') || cellText.includes('кронштейны (вставки)')) {
          row.remove();
        }
      }
    }

    function appendRow(tbody, name, size, qty, lengthMm, note) {
      if (!tbody) return;
      const tr = document.createElement('tr');
      tr.innerHTML =
        `<td>${name}</td>
         <td>${size}</td>
         <td>п.м.</td>
         <td>${qty}</td>
         <td>${lengthMm.toFixed(0)}</td>
         <td>${mmToMeters(lengthMm)}</td>
         <td>${note || ''}</td>`;
      tbody.appendChild(tr);
    }

    function addLines() {
      const params = readStoneBracketParams();
      const tbody = findEstimateBody();
      if (!tbody) return;
      // Remove previous inserted rows
      removeExistingRows(tbody);
      const { kind, C, T, F, G, count } = params;
      // Only proceed for valid widths and heights
      if (!C || !T) return;
      // Add stones if applicable
      if ((kind === 'type2' || kind === 'type4' || kind === 'type5') && F > 0) {
        const qty = 2 * count;
        const totalLengthMm = F * qty;
        appendRow(tbody,
          'Камни (вставки)',
          `h${F}×${C}×${T}`,
          qty,
          totalLengthMm,
          `ширина = ${C} мм`
        );
      }
      // Add brackets if applicable
      if (kind === 'type5' && G > 0) {
        const qty = 2 * count;
        const totalLengthMm = G * qty;
        appendRow(tbody,
          'Кронштейны (вставки)',
          `h${G}×${C}×${T}`,
          qty,
          totalLengthMm,
          `ширина = ${C} мм`
        );
      }
    }

    // Hook into button click
    document.addEventListener('DOMContentLoaded', function () {
      const btn = findCalcButton();
      if (btn) {
        btn.addEventListener('click', function () {
          // Delay to allow base estimate to render
          setTimeout(addLines, 50);
        });
      }
    });
  })();
