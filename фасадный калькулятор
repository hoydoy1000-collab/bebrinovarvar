  <style>
    :root {
      --primary: #2563eb;
      --primary-light: #3b82f6;
      --secondary: #475569;
      --success: #059669;
      --warning: #d97706;
      --error: #dc2626;
      --info: #0284c7;
      --bg-primary: #ffffff;
      --bg-secondary: #f8fafc;
      --bg-tertiary: #e0f2fe;
      --text-primary: #1e293b;
      --text-secondary: #475569;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --radius: 0.75rem;
      --shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
      
      --linear-color: #059669;
      --piece-color: #d97706;
      /* Additional custom colours used in UI elements */
      --miter-color: #dc2626;
      --auto-color: #0284c7;
      --work-color: #7c3aed;
    }
    /* Dark theme variables are defined outside of :root to work when the body has the class `.dark-mode`.  */

    /* Additional dark-mode overrides to ensure all sections adapt properly */
    /* Generic card backgrounds and headers for dark theme */
    body.dark-mode .card { background: var(--bg-secondary) !important; border-color: var(--border) !important; }
    body.dark-mode .card-header { background: var(--bg-tertiary) !important; border-bottom: 1px solid var(--border) !important; }
    /* Type-specific cards also inherit the dark styles */
    body.dark-mode .type1-card,
    body.dark-mode .type2-card,
    body.dark-mode .type3-card {
      background: var(--bg-secondary) !important;
      border-color: var(--border) !important;
    }
    body.dark-mode .type1-card .card-header,
    body.dark-mode .type2-card .card-header,
    body.dark-mode .type3-card .card-header {
      background: var(--bg-tertiary) !important;
      border-bottom: 1px solid var(--border) !important;
    }

    /* Input groups tinted backgrounds for dark mode */
    body.dark-mode .auto-field { background: rgba(5, 150, 105, 0.15) !important; border-color: var(--success) !important; }
    body.dark-mode .manual-field { background: rgba(2, 132, 199, 0.15) !important; border-color: var(--info) !important; }
    body.dark-mode .miter-checkbox-group { background: rgba(217, 119, 6, 0.12) !important; border-color: var(--warning) !important; }
    body.dark-mode .manual-inputs { background: rgba(2, 132, 199, 0.1) !important; border-color: var(--info) !important; }
    body.dark-mode .angle-input { background: rgba(217, 119, 6, 0.15) !important; border-color: var(--warning) !important; color: var(--text-primary) !important; }

    /* Price table rows and other subtle backgrounds under dark mode */
    body.dark-mode .pro-table tbody tr:nth-child(even) td { background: rgba(15, 23, 42, 0.5) !important; }
    body.dark-mode .price-table td { background: rgba(15, 23, 42, 0.5) !important; }
    body.dark-mode .price-table th { background: linear-gradient(135deg, var(--success), var(--success)) !important; color: white !important; }

    /* Style for theme toggle button */
    #theme-toggle-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      background: none;
      border: none;
      font-size: 1.8rem;
      cursor: pointer;
      color: inherit;
      z-index: 2;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; background: var(--bg-secondary); color: var(--text-primary); line-height: 1.6; }
    .container { max-width: 1400px; margin: 0 auto; padding: 20px; }

    .header {
      background: linear-gradient(135deg, var(--primary), var(--primary-light));
      color: white; padding: 32px; border-radius: var(--radius); margin-bottom: 30px; text-align: center;
      position: relative; overflow: hidden;
    }
    .header::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.1'%3E%3Ccircle cx='30' cy='30' r='4'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
      opacity: 0.3;
    }
    .header-content { position: relative; z-index: 1; }
    .header h1 { font-size: 2.75rem; font-weight: 800; margin-bottom: 12px; }
    .header-subtitle { font-size: 1.2rem; opacity: 0.95; font-weight: 500; }

    .card {
      background: var(--bg-primary); border: 1px solid var(--border); border-radius: var(--radius);
      box-shadow: var(--shadow); margin-bottom: 24px; overflow: hidden; position: relative;
    }
    .card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--primary); }
    .card-header { padding: 24px; background: var(--bg-tertiary); border-bottom: 1px solid var(--border); }
    .card-title { font-size: 1.4rem; font-weight: 700; color: var(--primary); margin-bottom: 8px; }
    .card-subtitle { font-size: 1rem; color: var(--text-muted); line-height: 1.5; }
    .card-content { padding: 28px; }

    .grid { display: grid; gap: 24px; }
    .grid-2 { grid-template-columns: repeat(2, 1fr); }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
    .grid-4 { grid-template-columns: repeat(4, 1fr); }

    /* Custom grid for the piece (штучные детали) panel: arrange fields horizontally */
    .piece-grid {
      /* Arrange the piece input fields horizontally using flexbox */
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
    }
    .piece-grid .form-group {
      /* Each group takes up equal space and can wrap; min width ensures multiple columns */
      flex: 1 1 220px;
      min-width: 0;
      gap: 8px;
    }

    .form-group { display: flex; flex-direction: column; gap: 10px; }
    .form-label { font-size: 15px; font-weight: 600; color: var(--text-secondary); }
    .form-input {
      width: 100%; height: 52px; padding: 14px 18px; border: 2px solid var(--border);
      border-radius: var(--radius); font-size: 16px; font-weight: 500; transition: all 0.2s;
    }
    .form-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgb(37 99 235 / 0.1); }

    .auto-field { background: rgba(5, 150, 105, 0.05); border-color: var(--success); position: relative; }
    .auto-field::after { 
      content: '🤖 АВТО'; position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
      background: var(--success); color: white; font-size: 11px; font-weight: 700;
      padding: 5px 10px; border-radius: 6px; pointer-events: none;
    }

    .manual-field { background: rgba(2, 132, 199, 0.05); border-color: var(--info); position: relative; }
    .manual-field::after { 
      content: '✏️ РУЧНОЙ'; position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
      background: var(--info); color: white; font-size: 11px; font-weight: 700;
      padding: 5px 10px; border-radius: 6px; pointer-events: none;
    }

    .mode-switcher {
      display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
      background: rgba(37, 99, 235, 0.05); padding: 12px 16px; border-radius: var(--radius);
    }
    .mode-switcher label { font-size: 14px; font-weight: 600; color: var(--text-secondary); }
    .mode-toggle {
      position: relative; width: 56px; height: 28px; background: var(--border);
      border-radius: 14px; cursor: pointer; transition: all 0.3s;
    }
    .mode-toggle.auto { background: var(--success); }
    .mode-toggle::after {
      content: ''; position: absolute; top: 2px; left: 2px; width: 24px; height: 24px;
      background: white; border-radius: 50%; transition: all 0.3s; box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
    .mode-toggle.auto::after { left: 30px; }

    .manual-inputs {
      display: none; margin-top: 16px; padding: 16px; 
      background: rgba(2, 132, 199, 0.03); border: 1px solid var(--info); border-radius: var(--radius);
    }
    .manual-inputs.visible { display: block; }
    .manual-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }

    .miter-checkbox-group {
      background: rgba(217, 119, 6, 0.05); border: 1px solid var(--warning);
      padding: 16px; border-radius: var(--radius); margin-top: 12px;
    }
    .miter-checkbox {
      display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 600;
    }
    .miter-checkbox input[type="checkbox"] {
      width: 20px; height: 20px; accent-color: var(--warning);
    }
    .angle-input-group {
      margin-top: 12px; opacity: 1; transition: opacity 0.3s;
    }
    .angle-input-group.disabled {
      opacity: 0.4; pointer-events: none;
    }
    .angle-input {
      height: 40px; border: 2px solid var(--warning);
      background: rgba(217, 119, 6, 0.05); text-align: center; font-weight: 600;
    }

    .checkbox-wrapper {
      display: flex; align-items: center; gap: 12px; height: 52px; padding: 0 18px;
      border: 2px solid var(--border); border-radius: var(--radius); cursor: pointer;
      background: var(--bg-primary); transition: all 0.2s;
    }
    .checkbox-wrapper:hover { border-color: var(--primary); }
    .checkbox { width: 20px; height: 20px; accent-color: var(--primary); cursor: pointer; flex-shrink: 0; }

    .button {
      display: inline-flex; align-items: center; justify-content: center; gap: 12px;
      height: 52px; padding: 0 28px; border: none; border-radius: var(--radius);
      font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.2s;
    }
    .button-primary { background: var(--primary); color: white; }
    .button-primary:hover { background: var(--primary-light); transform: translateY(-1px); }
    .button-secondary { background: var(--bg-tertiary); color: var(--text-primary); border: 2px solid var(--border); }
    .button-success { background: var(--success); color: white; }
    .button-warning { background: var(--warning); color: white; }
    .button-danger { background: var(--error); color: white; }
    /* Info button style */
    .button-info { background: var(--info); color: white; }
    .button-info:hover { filter: brightness(1.1); }

    .button-group { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }

    /* ===== ВЫБОР ТИПОВ ОКОН ===== */
    .window-type-option {
      cursor: pointer;
      border: 2px solid var(--border);
      border-radius: var(--radius);
      padding: 8px;
      transition: all 0.2s;
    }
    .window-type-option.selected {
      border-color: var(--primary);
      box-shadow: 0 0 0 2px var(--primary-light);
    }
    .window-type-option:hover {
      border-color: var(--primary);
    }

    /* ===== ПРОФЕССИОНАЛЬНАЯ ТАБЛИЦА ===== */
    .pro-table-container { 
      overflow-x: auto; border: 2px solid var(--border); border-radius: var(--radius); 
      background: var(--bg-primary); box-shadow: var(--shadow);
    }
    .pro-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .pro-table thead tr { background: linear-gradient(135deg, var(--primary), var(--primary-light)); }
    .pro-table th { 
      color: white; font-weight: 700; font-size: 13px; 
      padding: 16px 14px; text-align: left; line-height: 1.3;
      border-right: 1px solid rgba(255,255,255,0.2);
    }
    .pro-table th:last-child { border-right: none; }
    .pro-table td { 
      padding: 14px; border-bottom: 1px solid var(--border); vertical-align: middle; 
      border-right: 1px solid #f1f5f9; font-weight: 500;
    }
    .pro-table td:last-child { border-right: none; }
    .pro-table .text-right { text-align: right; }
    .pro-table .text-center { text-align: center; }
    .pro-table .font-mono { font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace; font-weight: 600; }
    
    .element-linear { border-left: 4px solid var(--linear-color); background: rgba(5, 150, 105, 0.02); }
    .element-piece { border-left: 4px solid var(--piece-color); background: rgba(217, 119, 6, 0.02); }
    .element-miter { box-shadow: inset 0 0 0 1px rgba(220, 38, 38, 0.1); }
    .element-work { border-left: 4px solid var(--work-color); background: rgba(124, 58, 237, 0.02); }

    .pro-table tfoot tr { background: linear-gradient(135deg, var(--success), #059669); }
    .pro-table tfoot td { 
      color: white; font-weight: 700; font-size: 15px; padding: 18px 14px;
      border-right: 1px solid rgba(255,255,255,0.2);
    }
    .pro-table tfoot td:last-child { border-right: none; }

    .badge { 
      display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px;
      font-size: 11px; font-weight: 700; border-radius: 6px; text-transform: uppercase;
      line-height: 1; white-space: nowrap;
    }
    .badge-linear { background: var(--linear-color); color: white; }
    .badge-piece { background: var(--piece-color); color: white; }
    .badge-miter { background: var(--miter-color); color: white; }
    .badge-auto { background: var(--auto-color); color: white; }
    .badge-manual { background: var(--info); color: white; }
    /* Success badge for generic statuses */
    .badge-success { background: var(--success); color: white; }
    .badge-work { background: var(--work-color); color: white; }

    .section-header {
      background: linear-gradient(135deg, #f1f5f9, #e2e8f0); 
      font-weight: 700; font-size: 14px; color: var(--text-secondary);
      padding: 12px 14px; border-bottom: 2px solid var(--border);
    }
    .section-header.materials { background: linear-gradient(135deg, rgba(5, 150, 105, 0.1), rgba(16, 185, 129, 0.1)); color: var(--success); }
    .section-header.work { background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(147, 51, 234, 0.1)); color: var(--work-color); }

    .total-materials { background: linear-gradient(135deg, var(--success), #047857) !important; }
    .total-work { background: linear-gradient(135deg, var(--work-color), #6d28d9) !important; }
    .total-grand { background: linear-gradient(135deg, var(--primary), var(--primary-light)) !important; font-size: 16px !important; }

    .minimal-mode { 
      background: linear-gradient(135deg, rgba(5, 150, 105, 0.03), rgba(16, 185, 129, 0.08)); 
      border: 2px solid var(--success); 
    }
    .work-mode { 
      background: linear-gradient(135deg, rgba(124, 58, 237, 0.03), rgba(147, 51, 234, 0.08)); 
      border: 2px solid var(--work-color); 
    }

    /* ===== ПРАЙС-ЛИСТ ===== */
    .collapse { 
      border: 2px solid var(--border); border-radius: var(--radius); 
      margin-bottom: 20px; background: var(--bg-primary); overflow: hidden;
    }
    .collapse-trigger {
      width: 100%; height: 60px; padding: 0 24px; background: var(--primary); border: none; 
      cursor: pointer; font-weight: 700; font-size: 16px; 
      display: flex; align-items: center; justify-content: space-between; color: white;
      transition: all 0.2s;
    }
    .collapse-trigger:hover { background: var(--primary-light); }
    .collapse-content { padding: 24px; background: var(--bg-primary); display: none; }
    .collapse.open .collapse-content { display: block; }
    .collapse-icon { transition: transform 0.3s ease; font-size: 18px; }
    .collapse.open .collapse-icon { transform: rotate(180deg); }

    .price-table { 
      width: 100%; border-collapse: collapse; font-size: 13px; 
      background: var(--bg-primary); border-radius: var(--radius); overflow: hidden;
    }
    .price-table th { 
      background: linear-gradient(135deg, var(--success), #059669); color: white; 
      font-weight: 700; font-size: 12px; padding: 12px 8px; text-align: center;
      border-right: 1px solid rgba(255,255,255,0.2);
    }
    .price-table td { 
      padding: 8px; border-bottom: 1px solid var(--border); text-align: center; 
      font-weight: 500; font-family: 'SF Mono', Monaco, monospace;
      border-right: 1px solid #f1f5f9; background: rgba(5, 150, 105, 0.02);
    }
    .price-table td:hover { background: rgba(37, 99, 235, 0.05); }
    .price-table .row-header { 
      background: var(--bg-tertiary); font-weight: 700; color: var(--primary);
      border-right: 2px solid var(--border);
    }

    .hidden { display: none; }
    .spinner { 
      width: 22px; height: 22px; border: 3px solid transparent; 
      border-top: 3px solid currentColor; border-radius: 50%; 
      animation: spin 1s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    @media (max-width: 768px) {
      .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
      .manual-grid { grid-template-columns: 1fr; }
      .header h1 { font-size: 2.2rem; }
      .card-content { padding: 20px; }
      .button-group { flex-direction: column; width: 100%; }
      .button { width: 100%; justify-content: center; }
    }

    /* Предотвращаем появление горизонтальной полосы прокрутки на странице */
    html, body {
      overflow-x: hidden;
      max-width: 100vw;
    }

    .door-hidden { display: none !important; }

    /* Скрываем карточку "Типы окон" по умолчанию, т.к. выбор типа осуществляется через выпадающий список. */
    #window_type_card { display: none !important; }

    /* === Dark mode clean up ===
       Some components define light backgrounds directly (e.g. #fafafa, #eaf9f1, etc.).
       To ensure there are no white patches in dark mode, we override these backgrounds
       and borders with the dark theme variables. Placing these rules at the end gives
       them higher specificity to win over earlier declarations. */
    body.dark-mode .card,
    body.dark-mode .type1-card,
    body.dark-mode .type2-card,
    body.dark-mode .type3-card {
      background: var(--bg-secondary) !important;
      border-color: var(--border) !important;
    }
    body.dark-mode .card-header,
    body.dark-mode .type1-card .card-header,
    body.dark-mode .type2-card .card-header,
    body.dark-mode .type3-card .card-header {
      background: var(--bg-tertiary) !important;
      border-color: var(--border) !important;
      color: var(--text-primary) !important;
    }
    body.dark-mode .collapse,
    body.dark-mode .collapse-content {
      background: var(--bg-secondary) !important;
      border-color: var(--border) !important;
    }
    body.dark-mode .section-header {
      background: var(--bg-tertiary) !important;
      color: var(--text-primary) !important;
      border-bottom-color: var(--border) !important;
    }
    body.dark-mode .price-table th {
      background: linear-gradient(135deg, var(--success), var(--success)) !important;
      color: white !important;
    }
    body.dark-mode .price-table td {
      background: rgba(15,23,42,0.4) !important;
      border-color: var(--border) !important;
    }

    /* Define dark theme CSS variables on body when the dark-mode class is present.  */
    body.dark-mode {
      --bg-primary: #0f172a;
      --bg-secondary: #1e293b;
      --bg-tertiary: #334155;
      --text-primary: #f1f5f9;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
      --border: #334155;
      /* Keep primary colours consistent for contrast */
      --primary: #2563eb;
      --primary-light: #3b82f6;
    }
  
/* PATCH START: pieces smeta table styles */
.smeta-table { width: 100%; border-collapse: collapse; }
.smeta-table th, .smeta-table td { padding: 8px 10px; border-bottom: 1px dashed rgba(0,0,0,0.1); vertical-align: top; }
.smeta-table th { text-align: left; font-weight: 600; }
.smeta-table td.num { text-align: right; white-space: nowrap; }
