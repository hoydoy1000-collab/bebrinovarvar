};

/**
 * Перехватываем основные функции расчётов, чтобы рендерить «Руст» после них.
 * Добавляет обёртку вокруг функций: updateCalculations, autoCalculateAll, updateManualCalculations,
 * professionalCalculateWithWork и calculateSmeta.
 */
function tryHookArea(){
  let hooked = false;
  ['updateCalculations','autoCalculateAll','updateManualCalculations','professionalCalculateWithWork','calculateSmeta'].forEach(fnName => {
    const original = window[fnName];
    if (typeof original === 'function' && !original.__patchedForArea){
      window[fnName] = function(){
        const res = original.apply(this, arguments);
        try {
          const items = appState.areaItems || [];
          renderAreaSmeta(items);
          renderStickSmeta(items);
        } catch(e){
          console.warn('renderAreaSmeta/renderStickSmeta error', e);
        }
        return res;
      };
      window[fnName].__patchedForArea = true;
      hooked = true;
    }
  });
  return hooked;
}

// Наблюдатель за таблицей результатов. Когда таблица пересоздаётся (после расчёта сметы),
// Rust-группа удаляется. С помощью MutationObserver мы снова вставляем строку «Руст» после изменений.
function initAreaTableObserver(){
  try {
    const table = document.getElementById('resultsTable');
    if (!table) return;
    const tbody = table.querySelector('tbody');
    if (!tbody) return;
    let timeoutId = null;
    const observer = new MutationObserver(() => {
      // debounce: перерисовываем Rust-группу через небольшую задержку,
      // чтобы избежать многократных вызовов.
      if (timeoutId) clearTimeout(timeoutId);
      timeoutId = setTimeout(() => {
        try {
          renderAreaSmeta(appState && appState.areaItems || []);
        } catch (e) {
          console.warn('Mutation observer renderAreaSmeta error', e);
        }
      }, 50);
    });
    observer.observe(tbody, { childList: true, subtree: false });
  } catch(e) {
    console.warn('initAreaTableObserver error', e);
  }
}

// При инициализации пробуем подключить перехват функций.
if (!tryHookArea()){
  document.addEventListener('DOMContentLoaded', function(){
    try {
      const items = appState.areaItems || [];
      renderAreaSmeta(items);
      renderStickSmeta(items);
    } catch(e){}
  });
}

// После полной загрузки документа инициализируем наблюдатель за таблицей сметы.
document.addEventListener('DOMContentLoaded', function(){
  initAreaTableObserver();
});
</script>
