  function initLightbox() {
    const ov = document.getElementById('ftbOverlay');
    if (!ov) return;
    ov.addEventListener('click', () => { ov.style.display = 'none'; });
  }

  // Initialize all
  function init() {
    insertTypeBanners();
    updateSelectPreview();
    const select = document.getElementById('kind_simple');
    if (select) select.addEventListener('change', updateSelectPreview);
    initLightbox();
  }
  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
})();
