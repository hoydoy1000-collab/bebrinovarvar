  370: [2123, 2228, 2422, 2571, 2855, 3289, 3424, 3767, 4111, 4455, 4646, 4898, 5274, 5681, 5965],
  400: [2228, 2086, 2542, 2733, 2975, 3394, 3516, 3917, 4300, 4709, 4865, 5023, 5555, 6040, 6339, 6811],
  420: [2362, 2422, 2601, 2855, 3110, 3453, 3708, 4081, 4425, 4835, 5083, 5400, 5902, 6369, 6656, 7062, 7376],
  450: [2482, 2542, 2763, 2975, 3259, 3516, 3857, 4171, 4551, 4960, 5337, 5807, 6183, 6656, 6952, 7472, 7786, 8288],
  470: [2601, 2661, 2915, 3169, 3394, 3618, 3917, 4395, 4709, 5164, 5555, 6010, 6369, 6877, 7221, 7705, 8073, 8551, 8880],
  500: [2691, 2826, 3050, 3259, 3483, 3708, 4019, 4551, 4898, 5430, 5807, 6339, 6686, 7221, 7565, 8103, 8477, 8970, 9359, 10046]
};

const FULL_PRICE_2025 = {};
for (const [w, arr] of Object.entries(RAW_PRICE_2025)) {
  const obj = {};
  for (let i = 0; i < arr.length; i++) obj[THICK_STEPS_MM[i]] = arr[i];
  FULL_PRICE_2025[w] = obj;
}

    let price = { ...FULL_PRICE_2025 };
    let autoCalculatedData = {};
    let calculationResults = null;
    
    let detailModes = {
      trim: 'auto',
      cornice: 'auto',
      sill: 'auto'
    };

    // ==================== УТИЛИТЫ ====================
    function formatNumber(value, decimals = 0) {
      return parseFloat(value || 0).toLocaleString('ru-RU', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
    }

    // Форматирование денежных значений с помощью библиотеки currency.js
    // Это обеспечивает точное округление и локальный формат для рублёвых сумм.
    function formatCurrency(value) {
      try {
        // Инициализируем объект currency с нужными параметрами: символ, разделитель тысяч и запятая.
        return currency(value || 0, {
          symbol: '₽',
          separator: ' ', // неразрывный пробел для тысячного разделителя
          decimal: ',',
          precision: 2
        }).format();
      } catch (e) {
        // fallback на стандартное форматирование, если библиотека не загружена
        return parseFloat(value || 0).toLocaleString('ru-RU', { style: 'currency', currency: 'RUB' });
      }
    }

    function showNotification(message, type = 'success') {
      if (typeof Swal !== 'undefined') {
        // Выбираем заголовок уведомления в зависимости от типа
        let titleText;
