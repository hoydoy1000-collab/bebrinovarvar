    function toggleDetailMode(detailType) {
      const currentMode = detailModes[detailType];
      const newMode = currentMode === 'auto' ? 'manual' : 'auto';
      detailModes[detailType] = newMode;
      
      const toggle = document.getElementById(`${detailType}_mode_toggle`);
      const label = document.getElementById(`${detailType}_mode_label`);
      const autoFields = document.getElementById(`${detailType}_auto_fields`);
      const manualInputs = document.getElementById(`${detailType}_manual_inputs`);
      
      if (newMode === 'manual') {
        toggle.classList.remove('auto');
        label.textContent = '✏️ РУЧНОЙ';
        label.style.color = 'var(--info)';
        
        autoFields.style.display = 'none';
        manualInputs.classList.add('visible');
        
        const inputs = autoFields.querySelectorAll('.form-input');
        inputs.forEach(input => {
          input.classList.remove('auto-field');
          input.classList.add('manual-field');
        });
        
        copyAutoToManual(detailType);
        showNotification(`${getDetailName(detailType)} — режим ручного ввода`, 'info');
      } else {
        toggle.classList.add('auto');
        label.textContent = '🤖 АВТО';
        label.style.color = 'var(--success)';
        
        autoFields.style.display = 'block';
        manualInputs.classList.remove('visible');
        
        const inputs = autoFields.querySelectorAll('.form-input');
        inputs.forEach(input => {
          input.classList.add('auto-field');
          input.classList.remove('manual-field');
        });
        
        showNotification(`${getDetailName(detailType)} — автоматический расчёт`, 'success');
      }
      
      updateCalculations();
    }

