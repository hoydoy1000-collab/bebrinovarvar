    }catch(e){}
    var n = Number(x||0);
    return n.toLocaleString('ru-RU', {minimumFractionDigits: 2, maximumFractionDigits: 2});
  }

  function renderPiecesSmeta(pieces){
    try{
      var wrap = ensurePiecesSmetaSection();
