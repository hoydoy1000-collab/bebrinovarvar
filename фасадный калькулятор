          default: titleText = '';
        }
        Swal.fire({
          title: titleText,
          html: message,
          icon: type,
          timer: 3000,
          showConfirmButton: false,
          toast: true,
          position: 'top-end'
        });
      } else {
        // fallback на стандартный alert без обращения к глобальным переменным
        alert(message);
      }
    }

    /**
     * Найти цену по ширине и толщине.
     *
     * Логика подбирает ближайший доступный размер из прайса так,
     * чтобы выбранная ширина (rw) была не меньше как входной ширины, так и входной толщины,
     * а выбранная толщина (ct) была не меньше входной толщины. Если подходящих
     * значений нет, выбирается наибольший доступный размер. Это поведение
     * повторяет использование официального прайс‑листа, где цена для изделия
     * определяется минимально подходящими размерами.
     *
     * @param {number} w_mm – требуемая ширина в миллиметрах
     * @param {number} t_mm – требуемая толщина в миллиметрах
     * @returns {{w:number, t:number, p:number}} – подобранная ширина, толщина и цена
     */
    function lookupPrice(w_mm, t_mm) {
      try {
        // Получаем список доступных ширин (ключи объекта price) и сортируем
        const rows = Object.keys(price).map(Number).sort((a, b) => a - b);
        // Определяем требуемую ширину: она должна быть не меньше входной ширины.
        const req = parseFloat(w_mm) || 0;
        // Находим ширину, которая не меньше требуемой.
        let rw = rows.find(r => r >= req);
        if (!rw) rw = rows[rows.length - 1];

        // Получаем список толщин для выбранной ширины и сортируем
        const available = Object.keys(price[rw] || {}).map(Number).sort((a, b) => a - b);
        // Выбираем толщину, которая не меньше заданной толщины
        let ct = available.find(c => c >= (parseFloat(t_mm) || 0));
        if (!ct) ct = available[available.length - 1];

        // Извлекаем цену, fallback – 500
        const p = price[rw]?.[ct] || 500;
        return { w: rw, t: ct, p };
      } catch (error) {
        // В случае ошибки возвращаем базовое значение
        const w = parseFloat(w_mm) || 80;
        const t = parseFloat(t_mm) || 20;
        return { w, t, p: 500 };
      }
    }

    // ==================== УПРАВЛЕНИЕ ПРАЙСОМ ====================
    function toggleCollapse(type) {
      const collapse = document.getElementById(`${type}Collapse`);
      const content = document.getElementById(`${type}Content`);
      const icon = document.getElementById(`${type}Icon`);
      
      if (collapse.classList.contains('open')) {
        collapse.classList.remove('open');
        content.style.display = 'none';
        icon.style.transform = 'rotate(0deg)';
      } else {
        collapse.classList.add('open');
        content.style.display = 'block';
        icon.style.transform = 'rotate(180deg)';
        if (type === 'price') {
          buildPriceTable();
        }
      }
    }

    function buildPriceTable() {
      const headerRow = document.getElementById('priceTableHeader');
      const tbody = document.getElementById('priceTableBody');
      
      const allThicknesses = Array.from(
        new Set(Object.values(price).flatMap(obj => Object.keys(obj).map(Number)))
      ).sort((a, b) => a - b);
      
      headerRow.innerHTML = allThicknesses.map(thickness => 
        `<th style="min-width: 60px;">${thickness}</th>`
      ).join('');
      // Dynamically adjust the colspan of the thickness header in the first row
      const firstHeader = document.querySelector('#priceTable thead tr:nth-child(1) th:nth-child(2)');
      if (firstHeader) {
        firstHeader.colSpan = allThicknesses.length;
      }
      
      const widths = Object.keys(price).map(Number).sort((a, b) => a - b);
      
      tbody.innerHTML = widths.map(width => {
        let row = `<td class="row-header">${width}</td>`;
        
        allThicknesses.forEach(thickness => {
          const priceValue = price[width]?.[thickness];
          if (priceValue) {
            row += `<td title="Ширина: ${width}мм, Толщина: ${thickness}мм">${formatNumber(priceValue)}</td>`;
          } else {
            row += `<td style="background: #f8f9fa; color: #9ca3af;">—</td>`;
          }
        });
        
        return `<tr>${row}</tr>`;
      }).join('');
    }

    function exportPriceToExcel() {
      if (typeof XLSX === 'undefined') {
        showNotification('Библиотека XLSX не загружена', 'error');
        return;
      }
      
      const priceData = [];
      Object.entries(price).forEach(([width, thicknesses]) => {
        Object.entries(thicknesses).forEach(([thickness, priceValue]) => {
          priceData.push({
            'Ширина (мм)': width,
            'Толщина (мм)': thickness,
            'Цена (₽/м)': priceValue
          });
        });
      });
      
      const worksheet = XLSX.utils.json_to_sheet(priceData);
      const workbook = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(workbook, worksheet, 'Прайс 2025');
      XLSX.writeFile(workbook, `facade-price-2025-${new Date().toISOString().slice(0,10)}.xlsx`);
      showNotification('📊 Прайс экспортирован в Excel', 'success');
    }

    function validatePriceList() {
      let total = 0;
      let errors = 0;
      
      Object.entries(price).forEach(([width, thicknesses]) => {
        Object.entries(thicknesses).forEach(([thickness, priceValue]) => {
          total++;
          if (!priceValue || priceValue <= 0 || isNaN(priceValue)) {
            errors++;
          }
        });
      });
      
      if (errors === 0) {
        showNotification(`✅ Прайс валиден: ${total} позиций`, 'success');
      } else {
        showNotification(`❌ Найдено ${errors} ошибок из ${total} позиций`, 'error');
      }
    }

