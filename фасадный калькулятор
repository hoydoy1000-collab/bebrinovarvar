    if (row) tbody.removeChild(row);
  }
  // Если нет элементов, обновляем итог и выходим
  if (!items || items.length === 0) {
    updateFooterTotalFromTable();
    return;
  }
  // Вставляем заголовок группы
  const headTr = document.createElement('tr');
  headTr.className = '__area__';
  headTr.innerHTML = '<td colspan="8" style="font-weight:700;background:rgba(25,118,210,.08);border-left:3px solid var(--primary)">Руст</td>';
