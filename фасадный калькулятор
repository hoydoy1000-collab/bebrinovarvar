      console.error('renderPiecesSmeta error', err);
    }
  }
  window.renderPiecesSmeta = renderPiecesSmeta;

  // Hook into global recalc if present
  function tryHook(){
    var hooked = false;
    ['updateCalculations','autoCalculateAll','updateManualCalculations'].forEach(function(fn){
      var original = window[fn];
      if (typeof original === 'function' && !original.__patchedForPiecesSmeta){
        window[fn] = function(){
          var res = original.apply(this, arguments);
          // Try to pull pieces from known getters if any
          var pieces = window.getPiecesList ? window.getPiecesList() : (window.appState && window.appState.pieces);
          try{ renderPiecesSmeta(pieces || []); } catch(e){ console.warn(e); }
          return res;
        };
        window[fn].__patchedForPiecesSmeta = true;
        hooked = true;
      }
    });
    return hooked;
  }
  if (!tryHook()){
    // As a fallback, render once on DOMContentLoaded
    document.addEventListener('DOMContentLoaded', function(){
      try{
        var pieces = window.getPiecesList ? window.getPiecesList() : (window.appState && window.appState.pieces);
        renderPiecesSmeta(pieces || []);
      }catch(e){}
    });
  }
})();
// PATCH END

