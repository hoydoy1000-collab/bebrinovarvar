  <!-- Script for theme toggling and keyboard shortcuts (undo) -->
  <script>
    (function() {
      // Stack to store previous project states for undo functionality
      let undoStack = [];
      // Undo function: restore previous project state
      function undoLastAction() {
        // Undo removes the most recently added object from the project via its ID
        try {
          const stored = localStorage.getItem('facade_project_list');
          let list = [];
          if (stored) list = JSON.parse(stored) || [];
          if (list.length > 0) {
            const lastObj = list[list.length - 1];
            const lastId = lastObj && lastObj.id;
            if (lastId && typeof deleteProjectObject === 'function') {
              // invoke the built-in deleteProjectObject to update internal state and storage
              deleteProjectObject(lastId);
              showNotification('Последний объект удалён', 'success');
              return;
            }
          }
          showNotification('Нет объектов для отмены', 'warning');
        } catch (e) {
          showNotification('Нет объектов для отмены', 'warning');
        }
      }
      // Setup hooks for undo on add, delete, edit after DOM content is loaded
      function setupUndoHooks() {
        // Hook addCurrentObject
        if (typeof window.addCurrentObject === 'function') {
          const origAdd = window.addCurrentObject;
          window.addCurrentObject = async function() {
            try {
              undoStack.push(JSON.parse(JSON.stringify(projectList)));
            } catch (e) {}
            return origAdd.apply(this, arguments);
          };
        }
        // Hook deleteProjectObject
        if (typeof window.deleteProjectObject === 'function') {
          const origDel = window.deleteProjectObject;
          window.deleteProjectObject = function(id) {
            try { undoStack.push(JSON.parse(JSON.stringify(projectList))); } catch (e) {}
            return origDel.call(this, id);
          };
        }
        // Hook editProjectObject
        if (typeof window.editProjectObject === 'function') {
          const origEdit = window.editProjectObject;
          window.editProjectObject = function(id) {
            try { undoStack.push(JSON.parse(JSON.stringify(projectList))); } catch (e) {}
            return origEdit.call(this, id);
          };
        }
      }
      // Theme application and toggle
      function applyTheme(theme) {
        if (theme === 'dark') {
          document.body.classList.add('dark-mode');
        } else {
          document.body.classList.remove('dark-mode');
        }
        const btn = document.getElementById('theme-toggle-btn');
        if (btn) {
          btn.textContent = theme === 'dark' ? '☀️' : '🌙';
        }
      }
      function toggleTheme() {
        let current = localStorage.getItem('theme') || 'light';
        const next = current === 'light' ? 'dark' : 'light';
        localStorage.setItem('theme', next);
        applyTheme(next);
      }
      // Initialize theme and button listeners after DOM load
      document.addEventListener('DOMContentLoaded', function() {
        const saved = localStorage.getItem('theme') || 'light';
        applyTheme(saved);
        const btn = document.getElementById('theme-toggle-btn');
        if (btn) {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            toggleTheme();
          });
        }
        // Initialize undo hooks once global functions have been defined
        setupUndoHooks();
      });
      // Keyboard shortcuts
      document.addEventListener('keydown', function(e) {
        // Undo with Ctrl/Cmd + Z (no shift)
        if ((e.ctrlKey || e.metaKey) && !e.shiftKey && e.key.toLowerCase() === 'z') {
          e.preventDefault();
          undoLastAction();
        }
        // Theme toggle with Ctrl/Cmd + Shift + L
        if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === 'l') {
          e.preventDefault();
          toggleTheme();
        }
      });
    })();
  </script>
