      }

      // Расчёт и отображение результатов с учётом qtyModes и pieceItems
      async function calculateAndShow() {
        // отключаем работы
        ['include_mounting','include_slopes','include_piece_work'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.checked = false;
        });
        // выполняем исходный расчёт
        if (typeof professionalCalculateWithWork === 'function') {
          await professionalCalculateWithWork();
        }
        // если calculationResults не сформирован
        if (!calculationResults || !calculationResults.materialItems) {
          showNotification('Не удалось выполнить расчёт', 'error');
          return;
        }
        // корректируем количества в материалах
        adjustResultsWithQtyAndPieces();
        // рендерим заново
        renderAdjustedResults();
        // отмечаем что готовы добавить в проект
        currentCalcReady = true;
      }

      // Корректировка результатов: замена qty в авто-режиме + добавление штучных
      function adjustResultsWithQtyAndPieces() {
        const autoQtys = computeAutoQtys();
        const newMaterialItems = [];
        // пересчитываем существующие материалы, учитывая включение/отключение элементов
        calculationResults.materialItems.forEach(item => {
          // пропускаем отключённые элементы (наличник, карниз, подоконник)
          if (item.type !== 'piece') {
            if (/^Наличник/.test(item.name) && !detailEnabled.trim) return;
            if (/^Карниз/.test(item.name) && !detailEnabled.cornice) return;
            if (/^Подоконник/.test(item.name) && !detailEnabled.sill) return;
          }
          let updatedItem = { ...item };
          // корректируем количество только для авто-режима
          if (item.mode === 'auto') {
            if (/^Наличник/.test(item.name)) {
              const oldQty = item.qty || autoQtys.trim;
              const newQty = qtyModes.trim.linked ? oldQty : qtyModes.trim.override;
              const factor = oldQty > 0 ? (newQty / oldQty) : 1;
              updatedItem.qty = newQty;
              updatedItem.sum = (item.sum || 0) * factor;
            } else if (/^Карниз/.test(item.name)) {
              const oldQty = item.qty || autoQtys.cornice;
              const newQty = qtyModes.cornice.linked ? oldQty : qtyModes.cornice.override;
              const factor = oldQty > 0 ? (newQty / oldQty) : 1;
              updatedItem.qty = newQty;
              updatedItem.sum = (item.sum || 0) * factor;
            } else if (/^Подоконник/.test(item.name)) {
              const oldQty = item.qty || autoQtys.sill;
              const newQty = qtyModes.sill.linked ? oldQty : qtyModes.sill.override;
              const factor = oldQty > 0 ? (newQty / oldQty) : 1;
              updatedItem.qty = newQty;
              updatedItem.sum = (item.sum || 0) * factor;
            }
          }
          newMaterialItems.push(updatedItem);
        });
        // добавляем штучные детали
        // При формировании строки для "штучной детали" используем исходные размеры (см),
        // чтобы корректно построить размер hH×W×T в мм. Длина для одной детали = piece.length * 1000 мм,
        // а суммарная длина умножается на количество. Цена/сумма вычисляются от pricePerM и количества метров.
        (window.pieceItems || []).forEach(piece => {
          // длина одной штуки в мм
          const perPieceMm  = Math.round(piece.length * 1000);
          // суммарная длина в метрах
          const totalMeters = piece.length * piece.qty;
          // суммарная сумма
          const totalSum    = (typeof currency !== 'undefined')
            ? currency(piece.pricePerM).multiply(totalMeters).value
            : piece.pricePerM * totalMeters;
          // Размер: hH×W×T, где H = h_cm * 10 мм, W = w_cm * 10 мм, T = t_cm * 10 мм
          const hMm = piece.__src ? Math.round(piece.__src.h_cm * 10) : perPieceMm;
          const wMm = piece.__src ? Math.round(piece.__src.w_cm * 10) : Math.round(piece.width);
          const tMm = piece.__src ? Math.round(piece.__src.t_cm * 10) : Math.round(piece.thickness);
          newMaterialItems.push({
            name: piece.name,
            size: `h${hMm}×${wMm}×${tMm}`,
            unit: 'шт',
            qty: piece.qty,
            baseLength: perPieceMm,
            totalLength: perPieceMm * piece.qty,
            meters: totalMeters,
            unitPrice: piece.pricePerM,
            sum: totalSum,
            type: 'piece',
            hasMiter: false,
            mode: 'manual'
          });
        });
        // записываем
        calculationResults.materialItems = newMaterialItems;
        calculationResults.workItems = []; // полностью исключаем работы
        calculationResults.materialTotal = newMaterialItems.reduce((sum, it) => sum + (it.sum || 0), 0);
        calculationResults.workTotal = 0;
        calculationResults.total = calculationResults.materialTotal;
        // обновляем currentMaterials/currentTotal
        currentMaterials = JSON.parse(JSON.stringify(newMaterialItems));
        currentTotal = calculationResults.materialTotal;
      }

      // Рендер результирующей таблицы (без работ)
      function renderAdjustedResults() {
        const tbody = document.querySelector('#resultsTable tbody');
        const footer = document.getElementById('resultsFooter');
        const countEl = document.getElementById('resultsCount');
        if (!tbody || !footer || !countEl) return;
        const mats = calculationResults.materialItems || [];
        let html = '';
        if (mats.length > 0) {
          html += '<tr class="section-header materials"><td colspan="8">🧱 МАТЕРИАЛЫ</td></tr>';
          mats.forEach(item => {
            let rowClass = '';
            if (item.type === 'piece') {
              rowClass = 'element-piece';
            } else {
              rowClass = item.hasMiter ? 'element-linear element-miter' : 'element-linear';
            }
            // формируем бейджи
            let badges = '';
            if (item.type === 'piece') {
              badges += '<span class="badge badge-piece">ШТ</span>';
            } else {
              badges += '<span class="badge badge-linear">МП</span>';
              if (item.hasMiter) badges += '<span class="badge badge-miter">С ЗАПИЛАМИ</span>';
              badges += `<span class="badge ${item.mode === 'auto' ? 'badge-auto' : 'badge-manual'}">${item.mode === 'auto' ? '🤖 АВТО' : '✏️ РУЧНОЙ'}</span>`;
            }
            html += `<tr class="${rowClass}"><td><div style="font-weight:600; margin-bottom:4px;">${escapeHtml(item.name)}</div><div style="display:flex; gap:8px; flex-wrap:wrap;">${badges}</div></td><td class="text-center font-mono" style="font-weight:600;">${item.size || '—'}</td><td class="text-center" style="font-weight:600; color:${item.type === 'piece' ? 'var(--piece-color)' : 'var(--linear-color)'};">${item.type === 'piece' ? 'шт' : 'мп'}</td><td class="text-right font-mono">${formatNumber(item.qty)}</td><td class="text-right font-mono">${formatNumber(item.totalLength || 0, 0)}</td><td class="text-right font-mono">${formatNumber(item.meters || 0, 3)}</td><td class="text-right font-mono">${formatNumber(item.unitPrice)}</td><td class="text-right font-mono" style="font-weight:700; color:${item.type === 'piece' ? 'var(--piece-color)' : 'var(--success)'};">${formatCurrency(item.sum)}</td></tr>`;
          });
        }
        tbody.innerHTML = html;
        // футер
        const materialTotal = calculationResults.materialTotal || 0;
        footer.innerHTML = `<tr class="total-grand"><td colspan="7" class="text-right" style="color:white; font-weight:700; font-size:17px;">🎯 ОБЩАЯ СТОИМОСТЬ:</td><td class="text-right font-mono" style="color:white; font-weight:700; font-size:17px;">${formatCurrency(materialTotal)}</td></tr>`;
        footer.classList.remove('hidden');
        countEl.textContent = `${mats.length} позиций`;
        // показать экспорт
        ['excelBtn','pdfBtn'].forEach(id => {
          const btn = document.getElementById(id);
          if (btn) btn.classList.remove('hidden');
        });
      }

      // Хук: переопределяем autoCalculateAll, toggleDetailMode, updateManualCalculations чтобы обновлять qty UI
      const originalAutoCalculateAll = autoCalculateAll;
      autoCalculateAll = function() {
        originalAutoCalculateAll();
        updateDefaultQtyOverrides();
      };
      const originalToggleDetailMode = toggleDetailMode;
      toggleDetailMode = function(detail) {
        originalToggleDetailMode(detail);
        updateQtyUIForDetail(detail);
      };

      // Инициализация после загрузки DOM
      document.addEventListener('DOMContentLoaded', function() {
        // Сохраняем дефолтные значения всех input/checkbox/select
        document.querySelectorAll('input, select, textarea').forEach(el => {
          if (!el.id) return;
          if (el.type === 'checkbox') {
            defaultValues[el.id] = el.checked;
          } else {
            defaultValues[el.id] = el.value;
          }
        });
        // Прячем исходный блок работ
        const workCard = document.querySelector('.card.work-mode');
        if (workCard) workCard.style.display = 'none';
        // Прячем исходную группу кнопок в блоке сметы (но оставим сами экспортные кнопки)
        const calcBtn = document.getElementById('calculateBtn');
        if (calcBtn && calcBtn.parentElement) {
          calcBtn.parentElement.style.display = 'none';
        }

        // Скрываем все группы запилов (miters), так как они больше не используются
        try { hideMiterGroups(); } catch (e) {}
        // Загружаем состояние из localStorage
        loadAppState();
        // Создаём и добавляем панели
        const main = document.querySelector('main');
        if (main) {
          const enableCard = createEnablePanel();
          // Пропускаем создание и вставку панели количества деталей, она больше не используется
          const areaCard = createAreaPanel();
          const pieceCard = createPiecePanel();
          const actionsCard = createActionsPanel();
          const projectCard = createProjectPanel();
          // Вставляем панели в логическом порядке перед сметой: выбор элементов, штучные детали, действия, смета, проект
          const refCard = document.getElementById('resultsTable')?.closest('.card');
          if (refCard) {
            // сначала выбор элементов
            refCard.parentNode.insertBefore(enableCard, refCard);
            // затем панель площади
            refCard.parentNode.insertBefore(areaCard, refCard);
            // затем штучные детали
            refCard.parentNode.insertBefore(pieceCard, refCard);
            // затем действия
            refCard.parentNode.insertBefore(actionsCard, refCard);
            // проект помещаем после сметы
            refCard.parentNode.insertBefore(projectCard, refCard.nextSibling);
          } else {
            main.appendChild(enableCard);
            // qtyCard не используем
            main.appendChild(areaCard);
            main.appendChild(pieceCard);
            main.appendChild(actionsCard);
            main.appendChild(projectCard);
          }
        }
        // Отрисовываем списки
        renderPieceList();
        renderProjectList();
        // Панель количества деталей удалена, поэтому не обновляем qty UI

        // Убираем авто-режим и скрываем переключатели
        applyManualMode();
        // Обновляем UI отключения деталей
        ['trim','cornice','sill'].forEach(updateDetailEnabledUI);

        // Обновляем отображение миниатюры для варианта Тип 1 (если определена функция)
        try {
          if (typeof updateKindPreview === 'function') updateKindPreview();
        } catch (e) {}
      });

      // === Начало блока выбора типа окна ===
      // состояние выбранного типа и описание типов
      let selectedWindowType = null;
      const windowTypes = {
        // === Определение Типа 1 ===
        type1: {
          name: 'Тип 1',
          includeSill: true,
          variables: {
            A: { name: 'Ширина проёма', source: 'openingWidth' },
            B: { name: 'Высота проёма', source: 'openingHeight' },
            C: { name: 'Ширина наличника', source: 'trimWidth' },
            E: { name: 'Толщина подоконника', source: 'sillThickness' }
          },
          formulas: {
            Ln: (A, B, C, E, F) => (B * 2 + A + 4 * C),
            Lp:(A,B,C,E)=> (A + 2*C + 4*E),
            Lo:(A,B,C,E)=> (A + 2*C)}
        },
        // === Определение Типа 2 ===
        type2: {
          name: 'Тип 2',
          includeSill: true,
          variables: {
            A: { name: 'Ширина проёма', source: 'openingWidth' },
            B: { name: 'Высота проёма', source: 'openingHeight' },
            C: { name: 'Ширина наличника', source: 'trimWidth' },
            E: { name: 'Толщина подоконника', source: 'sillThickness' },
            F: { name: 'Высота камня', source: 'stoneHeight' }
          },
          formulas: {
            Ln: (A, B, C, E, F) => (B * 2 + A + 4 * C - 2 * F),
            Lp: (A, B, C, E, F) => (A + 2 * C + 10 + 2 * E),
            Lo: (A, B, C, E, F) => (B * 2 + A)
          }
        },
        // === Определение Типа 3 ===
        type3: {
          name: 'Тип 3',
          includeSill: true,
          variables: {
            A: { name: 'Ширина проёма', source: 'openingWidth' },
            B: { name: 'Высота проёма', source: 'openingHeight' },
            C: { name: 'Ширина наличника', source: 'trimWidth' },
            E: { name: 'Толщина карниза', source: 'corniceThickness' },
            F: { name: 'Толщина подоконника', source: 'sillThickness' }
          },
          formulas: {
            Ln: (A, B, C, E, F) => (B * 2),
            Lp: (A, B, C, E, F) => (A + 2 * C + 10 + 2 * F),
            Lo: (A, B, C, E, F) => (B * 2 + A)
          }
        },
        // === Определение Типа 4 ===
        type4: {
          name: 'Тип 4 — окно с карнизом и камнями',
          includeSill: true,
          variables: {
            A: { name: 'Ширина проёма', source: 'openingWidth' },
            B: { name: 'Высота проёма', source: 'openingHeight' },
            C: { name: 'Ширина наличника', source: 'trimWidth' },
            E: { name: 'Толщина подоконника', source: 'sillThickness' },
            D: { name: 'Толщина карниза', source: 'corniceThickness' },
            F: { name: 'Высота камня', source: 'stoneHeight' }
          },
          formulas: {
            // Ln – длина наличника для типа 4: 2*B – 2*F
            Ln: (A, B, C, E, F) => {
              const stone = typeof getStoneHeightForFormulas === 'function' ? getStoneHeightForFormulas() : F;
              return (B * 2) - (stone ? 2 * stone : 0);
            },
            // Lp – длина подоконника: A + 2*C + 10 + 2*E
            Lp: (A, B, C, E, F) => (A + 2 * C + 10 + 2 * E),
            // Lo – длина откосов: 2*B + A
            Lo: (A, B, C, E, F) => (B * 2 + A),
            // Lk – длина карниза: A + 2*C + 10 + 4*D
            Lk: (A, B, C, E, F) => (A + 2 * C + 10 + 4 * (typeof getCorniceThicknessForFormulas === 'function' ? getCorniceThicknessForFormulas() : 0))
          }
        },
        // === Определение Типа 5 ===
        type5: {
          name: 'Тип 5 — окно с карнизом, камнями и кронштейнами',
          includeSill: true,
          variables: {
            A: { name: 'Ширина проёма', source: 'openingWidth' },
            B: { name: 'Высота проёма', source: 'openingHeight' },
            C: { name: 'Ширина наличника', source: 'trimWidth' },
            E: { name: 'Толщина подоконника', source: 'sillThickness' },
            D: { name: 'Толщина карниза', source: 'corniceThickness' },
            F: { name: 'Высота камня', source: 'stoneHeight' },
            G: { name: 'Высота кронштейна', source: 'bracketHeight' }
          },
          formulas: {
            // Ln – длина наличника: 2*B – 2*F – 2*G
            Ln: (A, B, C, E, F) => {
              const stone = typeof getStoneHeightForFormulas === 'function' ? getStoneHeightForFormulas() : F;
              const bracket = typeof getBracketHeightForFormulas === 'function' ? getBracketHeightForFormulas() : 0;
              return (B * 2) - (stone ? 2 * stone : 0) - (bracket ? 2 * bracket : 0);
            },
            // Lp – длина подоконника: A + 2*C + 10 + 2*E
            Lp: (A, B, C, E, F) => (A + 2 * C + 10 + 2 * E),
            // Lo – длина откосов: 2*B + A
            Lo: (A, B, C, E, F) => (B * 2 + A),
            // Lk – длина карниза: A + 2*C + 10 + 4*D
            Lk: (A, B, C, E, F) => (A + 2 * C + 10 + 4 * (typeof getCorniceThicknessForFormulas === 'function' ? getCorniceThicknessForFormulas() : 0))
          }
        }
      };
      
      // Получить толщину карниза D для формул
      function getCorniceThicknessForFormulas() {
        const kind = document.getElementById('kind_simple')?.value || 'type1';
        if (kind === 'type3') {
          const d3 = parseFloat(document.getElementById('type3_cornice_thickness')?.value);
          if (!isNaN(d3)) return d3;
        }
        if (kind === 'type4') {
          const d4 = parseFloat(document.getElementById('type4_cornice_thickness')?.value);
          if (!isNaN(d4)) return d4;
        }
        if (kind === 'type5') {
          const d5 = parseFloat(document.getElementById('type5_cornice_thickness')?.value);
          if (!isNaN(d5)) return d5;
        }
        const manual = parseFloat(document.getElementById('manual_cornice_thickness')?.value);
        return isNaN(manual) ? (autoCalculatedData?.corniceThickness || 0) : manual;
      }
      // Получить высоту камня F для формул
      function getBracketHeightForFormulas() {
        const kind = document.getElementById('kind_simple')?.value || 'type1';
        if (kind === 'type5') {
          const g5 = parseFloat(document.getElementById('type5_bracket_height')?.value);
          if (!isNaN(g5)) return g5;
        }
        return 0;
      }

      function getStoneHeightForFormulas() {
        const kind = document.getElementById('kind_simple')?.value || 'type1';
        if (kind === 'type2') {
          const f2 = parseFloat(document.getElementById('type2_stone_height')?.value);
          if (!isNaN(f2)) return f2;
        }
        if (kind === 'type4') {
          const f4 = parseFloat(document.getElementById('type4_stone_height')?.value);
          if (!isNaN(f4)) return f4;
        }
        if (kind === 'type5') {
          const f5 = parseFloat(document.getElementById('type5_stone_height')?.value);
          if (!isNaN(f5)) return f5;
        }
        return 0;
      }

      // выбор типа – сохраняем ключ и обновляем отображение
      function selectWindowType(key) {
        selectedWindowType = key;
        // сохраняем выбранный тип в глобальном объекте, чтобы использовать его из других функций
        window.selectedWindowType = key;
        renderWindowTypeInfo();
        highlightWindowTypeSelection();
      }
      // визуально выделяет выбранную плитку
      function highlightWindowTypeSelection() {
        const opts = document.querySelectorAll('.window-type-option');
        opts.forEach(el => el.classList.remove('selected'));
        if (selectedWindowType) {
          const el = document.getElementById('window_type_option_' + selectedWindowType);
          if (el) el.classList.add('selected');
        }
      }
      // получение актуальной ширины наличника (мм) с учётом режима
      function getTrimWidthForFormulas() {
        try {
        // Если выбран тип проёма type1 или type2, используем значения из соответствующих блоков
        const kSel = document.getElementById('kind_simple')?.value || 'type1';
        if (kSel === 'type1') {
          const t1v = parseFloat(document.getElementById('type1_trim_width')?.value);
          return isNaN(t1v) ? 0 : t1v;
        }
        if (kSel === 'type2') {
          const t2v = parseFloat(document.getElementById('type2_trim_width')?.value);
          return isNaN(t2v) ? 0 : t2v;
        }
        if (kSel === 'type3') {
          const t3v = parseFloat(document.getElementById('type3_trim_width')?.value);
          return isNaN(t3v) ? 0 : t3v;
        }
        if (detailModes && detailModes.trim === 'manual') {
            const v = parseFloat(document.getElementById('manual_trim_width').value);
            return isNaN(v) ? 0 : v;
        }
        if (autoCalculatedData) return autoCalculatedData.trimWidth || 0;
        } catch(e) {}
        return 0;
      }
      // получение актуальной толщины подоконника (мм) с учётом режима
      function getSillThicknessForFormulas() {
        const kind = document.getElementById('kind_simple')?.value || 'type1';
        // Для type1 и type2 используем значения из соответствующих блоков, если указано
        if (kind === 'type1') {
          const t1e = parseFloat(document.getElementById('type1_sill_thickness')?.value);
          return isNaN(t1e) ? 0 : t1e;
        }
        if (kind === 'type2') {
          const t2e = parseFloat(document.getElementById('type2_sill_thickness')?.value);
          return isNaN(t2e) ? 0 : t2e;
        }
        if (kind === 'type3') {
          // для типа 3 возвращаем толщину подоконника из блока типа 3 (значение F)
          const t3e = parseFloat(document.getElementById('type3_sill_thickness')?.value);
          return isNaN(t3e) ? 0 : t3e;
        }
        // Если это не тип 1 и не тип 2, используем ручные или авто-настройки
        try {
          if (detailModes && detailModes.sill === 'manual') {
            const v = parseFloat(document.getElementById('manual_sill_thickness').value);
            return isNaN(v) ? 0 : v;
          }
          if (autoCalculatedData) return autoCalculatedData.sillThickness || 0;
        } catch(e) {}
        return 0;
      }
      // обновляет панель формул и изображение выбранного типа
      function renderWindowTypeInfo() {
        const card = document.getElementById('window_type_card');
        if (!card) return;
        // показываем/скрываем карточку в зависимости от типа проёма
        const kind = document.getElementById('kind_simple')?.value || 'type1';
        if (kind !== 'window') {
          card.style.display = 'none';
        } else {
          card.style.display = '';
        }
        const infoEl = document.getElementById('window_type_info');
        const imgEl = document.getElementById('window_type_image');
        const formEl = document.getElementById('window_type_formulas');
        if (!infoEl || !imgEl || !formEl) return;
        if (!selectedWindowType || !windowTypes[selectedWindowType]) {
          infoEl.style.display = 'none';
          return;
        }
        const wt = windowTypes[selectedWindowType];
        infoEl.style.display = 'block';
        imgEl.src = wt.image;
        let A = parseFloat(document.getElementById('A_simple').value) || 0;
        let B = parseFloat(document.getElementById('B_simple').value) || 0;
        let C = getTrimWidthForFormulas();
        // По умолчанию E – это толщина подоконника (мм)
        let E = getSillThicknessForFormulas();
        let F = 0;
        try {
          const kindSel = document.getElementById('kind_simple')?.value || 'type1';
          if (kindSel === 'type2') {
            // Для типа 2 F – высота камня
            const fVal = parseFloat(document.getElementById('type2_stone_height')?.value);
            F = isNaN(fVal) ? 0 : fVal;
          } else if (kindSel === 'type3') {
            // Для типа 3 параметры:
            // E – толщина карниза; F – толщина подоконника
            const tCorn = parseFloat(document.getElementById('type3_cornice_thickness')?.value);
            E = isNaN(tCorn) ? 0 : tCorn;
            const tSill = parseFloat(document.getElementById('type3_sill_thickness')?.value);
            F = isNaN(tSill) ? 0 : tSill;
          }
        } catch (e) { /* ignore */ }
        const Ln = wt.formulas.Ln(A, B, C, E, F);
        const Lp = wt.formulas.Lp(A, B, C, E, F);
        const Lo = wt.formulas.Lo(A, B, C, E, F);
        // сохраняем вычисленные значения в глобальном объекте для использования в расчёте сметы
        try {
          window.windowTypeValues = { Ln: Ln, Lp: Lp, Lo: Lo };
        } catch(e) {
          // noop if window is not available
        }
        // Формируем отображение: сначала выводим использованные данные с понятными названиями,
        // затем выводим результаты расчёта. Переменные и названия берём из описания типа.
        let infoHtml = '';
        if (wt.variables) {
          infoHtml += `<div style="font-size:15px;font-weight:700;margin-bottom:8px;">Используемые данные:</div>`;
          // Добавляем значения переменных. Для типа 2 переменная F также заполняется
          const varValues = { A: A, B: B, C: C, E: E, F: F };
          for (const key in wt.variables) {
            const vInfo = wt.variables[key];
            if (!vInfo || !vInfo.name) continue;
            const val = varValues[key] || 0;
            // Пропускаем нулевые значения, если переменная C или E отсутствует (например, нет подоконника)
            // Однако для ширины и высоты всегда выводим
            if ((key === 'C' || key === 'E') && val === 0) continue;
            infoHtml += `<div><strong>${vInfo.name}</strong>: ${val.toFixed(0)} мм</div>`;
          }
          infoHtml += `<div style="margin-top:12px;font-size:15px;font-weight:700;margin-bottom:8px;">Результаты расчёта:</div>`;
        } else {
          infoHtml += `<div style="font-size:15px;font-weight:700;margin-bottom:8px;">Результаты расчёта:</div>`;
        }
        // Выводим длины в понятном виде: наличие наличника, подоконника и обрамления
        infoHtml += `<div><strong>Lн</strong> – длина наличника: ${Ln.toFixed(0)} мм (${(Ln/1000).toFixed(3)} м)</div>`;
        if (wt.includeSill) {
          infoHtml += `<div><strong>Lп</strong> – длина подоконника: ${Lp.toFixed(0)} мм (${(Lp/1000).toFixed(3)} м)</div>`;
        }
        infoHtml += `<div><strong>Lо</strong> – длина обрамления: ${Lo.toFixed(0)} мм (${(Lo/1000).toFixed(3)} м)</div>`;
        formEl.innerHTML = infoHtml;
      }
      // === Конец блока выбора типа окна ===

      // Экспортируем структуры и выбранный тип в глобальный объект
      window.windowTypes = windowTypes;
      window.selectedWindowType = selectedWindowType;
      window.windowTypeValues = null;

      // === Дополнительные функции для Типа 1 ===
