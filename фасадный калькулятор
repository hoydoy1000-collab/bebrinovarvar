<script>
// Функция для вставки результатов площадного расчёта в профессиональную смету.
function insertAreaResult(A, B, qty, rate) {
  const tbody = document.querySelector('#resultsTable tbody');
  if (!tbody) return;
  // Удаляем заглушку, если она есть
  const placeholder = tbody.querySelector('tr > td[colspan="8"]');
  if (placeholder) {
    const row = placeholder.closest('tr');
    if (row) tbody.removeChild(row);
  }
  // Создаём заголовок группы, если ещё не создан
  let groupRow = document.getElementById('areaGroupRow');
  if (!groupRow) {
    groupRow = document.createElement('tr');
    groupRow.id = 'areaGroupRow';
    groupRow.className = 'section-header area';
    groupRow.innerHTML = '<td colspan="8">📐 ПЛОЩАДНОЙ РАСЧЁТ</td>';
    tbody.appendChild(groupRow);
  }
  // Вычисляем стоимость
  const pricePerItem = (A * B * rate) / 10000;
  const total = pricePerItem * qty;
  // Формируем строку
  const areaRow = document.createElement('tr');
  areaRow.className = 'element-area';
  areaRow.innerHTML = `
    <td><div style="font-weight:600;">Площадь ${formatNumber(A,0)}×${formatNumber(B,0)} мм</div><div style="display:flex; gap:8px; flex-wrap:wrap;"><span class="badge badge-linear">м²</span></div></td>
    <td class="text-center font-mono">—</td>
    <td class="text-center" style="font-weight:600;">м²</td>
    <td class="text-right font-mono">${formatNumber(qty)}</td>
    <td class="text-right font-mono">${formatNumber(A*B,0)}</td>
    <td class="text-right font-mono">${formatNumber((A*B)/10000*qty, 3)}</td>
    <td class="text-right font-mono">${formatNumber(pricePerItem)}</td>
    <td class="text-right font-mono" style="font-weight:700;">${formatCurrency(total)}</td>
  `;
  tbody.appendChild(areaRow);
  // Обновляем счётчик позиций
  const countEl = document.getElementById('resultsCount');
  if (countEl) {
    const m = countEl.textContent.match(/(\d+)/);
    let n = m ? parseInt(m[1], 10) : 0;
    countEl.textContent = (n + 1) + ' позиций';
  }
  // Обновляем общую стоимость в футере
  const footer = document.getElementById('resultsFooter');
  if (footer) {
    let current = 0;
    const cell = footer.querySelector('tr.total-grand td:last-child');
    if (cell) {
      const val = cell.textContent.replace(/[^\d,\.]/g,'').replace(',', '.');
      current = parseFloat(val) || 0;
    }
    const newTotal = current + total;
    footer.innerHTML = '<tr class="total-grand"><td colspan="7" class="text-right" style="color:white; font-weight:700; font-size:17px;">🎯 ОБЩАЯ СТОИМОСТЬ:</td><td class="text-right font-mono" style="color:white; font-weight:700; font-size:17px;">' + formatCurrency(newTotal) + '</td></tr>';
    footer.classList.remove('hidden');
  }
}

// ---- Устаревшая функция launchAreaModal (расчет в миллиметрах) убрана.
// Пожалуйста, используйте window.launchAreaModal для запуска модального расчёта площади.

// IIFE: скрываем исходную панель «Площадной расчёт» и добавляем плавающую кнопку
(function() {
  // Скрываем существующую карточку «Площадной расчёт»
  function hideAreaPanel() {
    const headings = Array.from(document.querySelectorAll('h2'));
    headings.forEach(h => {
      if (/Площадной\s+расчёт/i.test(h.textContent || '')) {
        const card = h.closest('.card');
        if (card) {
          // Полностью удаляем карточку площади из DOM, чтобы не занимала место
          card.remove();
        }
      }
    });
  }
  // Создаём плавающую кнопку для A×B
  function createAreaButton() {
    const btn = document.createElement('button');
    btn.id = 'areaFloatButton';
    btn.title = 'Площадной расчёт A×B';
    btn.textContent = 'A×B';
    Object.assign(btn.style, {
      position: 'fixed',
      bottom: '20px',
      right: '96px',
      zIndex: '2147483647',
      padding: '12px 16px',
      borderRadius: '50%',
      background: '#fb923c',
      color: '#fff',
      fontSize: '20px',
      border: 'none',
      cursor: 'pointer',
      boxShadow: '0 4px 12px rgba(0,0,0,.3)'
    });
    // при клике вызываем глобальную функцию launchAreaModal, чтобы использовать корректную версию с сантиметрами
    btn.addEventListener('click', function() {
      if (typeof window.launchAreaModal === 'function') {
        window.launchAreaModal();
      } else if (typeof launchAreaModal === 'function') {
        // fallback на старый обработчик при отсутствии новой реализации
        launchAreaModal();
      }
    });
