<script>
(function(){
  const STORAGE_PREFIX='facade_project:';
  const VERSION=1;
  function nowStamp(){const d=new Date();const pad=n=>String(n).padStart(2,'0');return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}_${pad(d.getHours())}-${pad(d.getMinutes())}-${pad(d.getSeconds())}`;}
  function lsOK(){try{const k='__ls_test__'+Math.random();localStorage.setItem(k,'1');localStorage.removeItem(k);return true;}catch(_){return false;}}
  function collect(){const s={};document.querySelectorAll('input, select, textarea').forEach(el=>{const id=el.id||el.name||null;if(!id)return;if(el.type==='checkbox'||el.type==='radio')s[id]=!!el.checked;else s[id]=el.value;});return s;}
  function applyForm(form){if(!form)return;Object.entries(form).forEach(([id,val])=>{const el=document.getElementById(id)||document.querySelector(`[name="${CSS.escape(id)}"]`);if(!el)return;if(el.type==='checkbox'||el.type==='radio')el.checked=!!val;else el.value=val;el.dispatchEvent(new Event('input',{bubbles:true}));el.dispatchEvent(new Event('change',{bubbles:true}));});}
  function snapshot(){const out={};['projectList','pieceItems','qtyModes','autoCalculatedData'].forEach(k=>{if(window[k]!==undefined)out[k]=window[k];});return out;}
  function payload(title){return {version:VERSION,savedAt:new Date().toISOString(),meta:{title:title||`Проект ${nowStamp()}`},form:collect(),globals:snapshot()};}
  function download(obj,name){const blob=new Blob([JSON.stringify(obj,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name||`facade-project-${nowStamp()}.json`;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},500);}
  function saveLocal(obj){if(!lsOK()){alert('LocalStorage недоступен. Используйте «Скачать .json».');return;}const base=(obj?.meta?.title||`Проект ${nowStamp()}`).trim().replace(/\s+/g,' ');let key=STORAGE_PREFIX+base;let i=2;while(localStorage.getItem(key)){key=STORAGE_PREFIX+base+' ('+(i++)+')';}localStorage.setItem(key,JSON.stringify(obj));toast('Проект сохранён: '+obj.meta.title);renderManager();}
  function listKeys(){if(!lsOK())return [];const arr=[];for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(k&&k.startsWith(STORAGE_PREFIX))arr.push(k);}return arr.sort();}
  function readLocal(key){if(!lsOK())return null;try{const raw=localStorage.getItem(key);return raw?JSON.parse(raw):null;}catch(_){return null;}}
  function removeLocal(key){if(!lsOK())return;localStorage.removeItem(key);}
  function renameLocal(oldKey,newTitle){const data=readLocal(oldKey);if(!data)return;const base=(newTitle||'Без названия').trim().replace(/\s+/g,' ');let newKey=STORAGE_PREFIX+base;let i=2;while(localStorage.getItem(newKey))newKey=STORAGE_PREFIX+base+' ('+(i++)+')';data.meta=data.meta||{};data.meta.title=newTitle;localStorage.setItem(newKey,JSON.stringify(data));localStorage.removeItem(oldKey);return newKey;}
  function applyPayload(p){if(!p)return;if(p.form)applyForm(p.form);toast('Проект загружен: '+(p?.meta?.title||'Без названия'));}
  let toastTimer;function toast(t){let el=document.getElementById('simpleToast');if(!el){el=document.createElement('div');el.id='simpleToast';Object.assign(el.style,{position:'fixed',right:'16px',top:'16px',zIndex:'1100',padding:'10px 12px',borderRadius:'12px',background:'var(--card)',border:'1px solid var(--border)',boxShadow:'var(--shadow)',color:'var(--text)'});document.body.appendChild(el);}el.textContent=t;el.style.opacity='1';clearTimeout(toastTimer);toastTimer=setTimeout(()=>{el.style.opacity='0';},2400);}
  const listEl=document.getElementById('projectList');const drawer=document.getElementById('projectDrawer');
  function renderManager(){if(!listEl)return;listEl.innerHTML='';const arr=listKeys();if(!arr.length){listEl.innerHTML='<div class="notice">Пока нет сохранённых проектов.</div>';return;}arr.forEach(k=>{const data=readLocal(k)||{};const title=data?.meta?.title||k.replace(STORAGE_PREFIX,'');const time=data?.savedAt?new Date(data.savedAt).toLocaleString():'';const row=document.createElement('div');row.className='project-item';row.innerHTML=`<div><div style="font-weight:700">${title}</div><div class="notice">${time}</div></div><div class="actions"><button data-act="load">Загрузить</button><button data-act="rename">Переименовать</button><button data-act="delete">Удалить</button><button data-act="download">Скачать</button></div>`;row.querySelector('[data-act="load"]').onclick=()=>{applyPayload(data);};row.querySelector('[data-act="rename"]').onclick=()=>{const nt=prompt('Новое имя проекта:',title);if(!nt)return;const nk=renameLocal(k,nt);if(nk){toast('Переименовано');renderManager();}};row.querySelector('[data-act="delete"]').onclick=()=>{if(confirm('Удалить проект «'+title+'»?')){removeLocal(k);renderManager();}};row.querySelector('[data-act="download"]').onclick=()=>{download(data,(title||'facade-project')+'.json');};listEl.appendChild(row);});}
  const btnSave=document.getElementById('btnSaveLocal');const btnDown=document.getElementById('btnDownload');const btnUp=document.getElementById('btnUpload');const btnMgr=document.getElementById('btnOpenManager');const btnClose=document.getElementById('btnCloseManager');const fileInput=document.getElementById('projectFileInput');
  btnSave&&btnSave.addEventListener('click',()=>{const title=prompt('Название проекта:','Проект '+nowStamp());const p=payload(title||'Без названия');saveLocal(p);});
  btnDown&&btnDown.addEventListener('click',()=>{const title=prompt('Название для файла .json:','Проект '+nowStamp());const p=payload(title||'Без названия');download(p,(p.meta.title||'facade-project')+'.json');});
  btnUp&&btnUp.addEventListener('click',()=>{fileInput&&fileInput.click();});
  fileInput&&fileInput.addEventListener('change',()=>{if(!fileInput.files||!fileInput.files.length)return;const f=fileInput.files[0];const rd=new FileReader();rd.onload=(e)=>{try{const p=JSON.parse(String(e.target.result||'{}'));if(p&&+p.version>=1)applyPayload(p);else alert('Формат файла не распознан.');}catch(err){alert('Не удалось прочитать JSON: '+err.message);}finally{fileInput.value='';}};rd.readAsText(f,'utf-8');});
  btnMgr&&btnMgr.addEventListener('click',()=>{renderManager();drawer&&drawer.classList.add('open');drawer&&drawer.setAttribute('aria-hidden','false');});
  btnClose&&btnClose.addEventListener('click',()=>{drawer&&drawer.classList.remove('open');drawer&&drawer.setAttribute('aria-hidden','true');});
})();
</script>

