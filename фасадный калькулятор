      // Изменить HTML специальные символы
      function escapeHtml(str) {
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;')
          .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      // Сохранение состояния формы
      function captureFormState() {
        const state = {};
        const inputs = document.querySelectorAll('input, select, textarea');
        inputs.forEach(el => {
          if (!el.id) return;
          if (el.type === 'checkbox') {
            state[el.id] = el.checked;
          } else {
            state[el.id] = el.value;
          }
        });
        // также сохраняем modes
        state.detailModes = JSON.parse(JSON.stringify(detailModes));
        state.qtyModes = JSON.parse(JSON.stringify(qtyModes));
        return state;
      }

      // Загрузка состояния формы
      function loadFormState(state) {
        // установить значения
        Object.keys(state).forEach(id => {
          if (id === 'detailModes' || id === 'qtyModes') return;
          const el = document.getElementById(id);
          if (!el) return;
          if (el.type === 'checkbox') {
            el.checked = state[id];
          } else {
            el.value = state[id];
          }
        });
        // восстановить режимы деталей
        if (state.detailModes) {
          Object.keys(state.detailModes).forEach(detail => {
            detailModes[detail] = state.detailModes[detail];
            // обновляем переключатели режимов
            const toggle = document.getElementById(`${detail}_mode_toggle`);
            const label = document.getElementById(`${detail}_mode_label`);
            const manualInputs = document.getElementById(`${detail}_manual_inputs`);
            const autoFields = document.getElementById(`${detail}_auto_fields`);
            if (toggle && label && manualInputs && autoFields) {
              if (detailModes[detail] === 'auto') {
                toggle.classList.add('auto');
                label.textContent = '🤖 АВТО';
                label.style.color = 'var(--success)';
                manualInputs.classList.remove('visible');
                autoFields.style.display = 'block';
              } else {
                toggle.classList.remove('auto');
                label.textContent = '✏️ РУЧНОЙ';
                label.style.color = 'var(--info)';
                manualInputs.classList.add('visible');
                autoFields.style.display = 'none';
              }
            }
          });
        }
        // восстановить qtyModes
        if (state.qtyModes) {
          ['trim','cornice','sill'].forEach(detail => {
            if (state.qtyModes[detail]) {
              qtyModes[detail] = {
                linked: state.qtyModes[detail].linked,
                override: state.qtyModes[detail].override
              };
            }
          });
        }
        // обновить UI количеств
        updateAllQtyUI();
        // пересчитать автоматические значения и отрисовать
        autoCalculateAll();
        updateMiterInputs();
        // если вручную введены поля, обновить
        updateManualCalculations();
        // пересчитаем авто поля override
        updateDefaultQtyOverrides();
      }

      // Отрисовка списка проектов
      function renderProjectList() {
        const container = document.getElementById('project_list');
        if (!container) return;
        if (projectList.length === 0 && pieceItems.length === 0) {
          container.innerHTML = '<div style="font-size: 14px; color: var(--text-muted);">Пока нет добавленных объектов.</div>';
          return;
        }
        let html = '<div class="pro-table-container"><table class="pro-table"><thead><tr><th style="width:5%;">#</th><th style="width:30%;">Объект</th><th style="width:20%;" class="text-right">Кол-во позиций</th><th style="width:20%;" class="text-right">Сумма, ₽</th><th style="width:25%;" class="text-center">Действия</th></tr></thead><tbody>';
        let totalObjects = 0;
        let totalSum = 0;
        projectList.forEach((obj, index) => {
          totalObjects += obj.materials.length;
          totalSum += obj.materialTotal;
          html += `<tr><td>${index+1}</td><td>${escapeHtml(obj.label || 'Объект '+(index+1))}</td><td class="text-right font-mono">${formatNumber(obj.materials.length)}</td><td class="text-right font-mono">${formatCurrency(obj.materialTotal)}</td><td class="text-center"><button class="button button-secondary" style="height:32px; padding:0 10px; font-size:14px; margin-right:6px;" onclick="editProjectObject('${obj.id}')">✏️</button><button class="button button-danger" style="height:32px; padding:0 10px; font-size:14px;" onclick="deleteProjectObject('${obj.id}')">🗑️</button></td></tr>`;
        });
        // Раньше сюда добавляли сумму штучных деталей (pieceItems) даже если они
        // не были добавлены в проект. Теперь «штучные» детали учитываются в
        // проекте только когда пользователь явно добавляет их через кнопку
        // «Добавить штучные детали». Поэтому мы не прибавляем сумму
        // pieceItems к totalSum здесь. Все позиции отображаются в проекте
        // исключительно из projectList.
        html += '</tbody><tfoot><tr><td colspan="3" class="text-right" style="color: white; font-weight:700;">ИТОГО ПРОЕКТ:</td><td class="text-right font-mono" style="color: white; font-weight:700;">'+formatCurrency(totalSum)+'</td><td></td></tr></tfoot></table></div>';
        container.innerHTML = html;
      }

      // Экспортируем функцию во внешний scope, чтобы её могли вызывать другие скрипты
      window.renderProjectList = renderProjectList;

      // Добавление текущего объекта в проект
      async function addCurrentObject() {
        // Сначала убеждаемся, что расчёт произведён
        if (!currentCalcReady) {
          await calculateAndShow();
        }
        if (!currentCalcReady) {
          showNotification('Сначала рассчитайте смету', 'warning');
          return;
        }
        const formState = captureFormState();
        // Формируем объект проекта
        const id = 'proj_' + Math.random().toString(36).substr(2, 9);
        // Определяем ключ выбранного типа проёма
        // Определяем ключ выбранного типа проёма преимущественно из текущего DOM, затем из сохранённого состояния
        const typeKey = document.getElementById('kind_simple')?.value || formState['kind_simple'] || 'type1';
        // Берём человекочитаемое название типа из объекта windowTypes, если доступно
        let typeLabel;
        try {
          if (windowTypes && windowTypes[typeKey] && windowTypes[typeKey].name) {
            typeLabel = windowTypes[typeKey].name;
          } else {
            // fallback: превращаем typeX в "Тип N"
            const num = typeKey.replace(/type/gi, '');
            typeLabel = 'Тип ' + num;
          }
        } catch (e) {
          const num = typeKey.replace(/type/gi, '');
          typeLabel = 'Тип ' + num;
        }
        // Заголовок включает размеры проёма в миллиметрах
        const A_val = parseFloat(document.getElementById('A_simple')?.value) || 0;
        const B_val = parseFloat(document.getElementById('B_simple')?.value) || 0;
        const label = `${typeLabel} (${formatNumber(A_val)}×${formatNumber(B_val)}мм)`;
        const obj = {
          id,
          label,
          formState,
          materials: JSON.parse(JSON.stringify(currentMaterials)),
          materialTotal: currentTotal
        };
        projectList.push(obj);
        saveAppState();
        renderProjectList();
        showNotification('Объект добавлен в проект', 'success');
        // Сброс флага готовности, чтобы следующий расчёт обновил смету
        currentCalcReady = false;
      }

      // Удаление объекта из проекта
      function deleteProjectObject(id) {
        projectList = projectList.filter(obj => obj.id !== id);
        saveAppState();
        renderProjectList();
        showNotification('Объект удалён', 'info');
      }

      // Редактирование объекта (загрузка его формы)
      function editProjectObject(id) {
        const idx = projectList.findIndex(obj => obj.id === id);
        if (idx === -1) return;
        const obj = projectList[idx];
        // удалить из проекта
        projectList.splice(idx,1);
        saveAppState();
        renderProjectList();
        // загрузить форму
        loadFormState(obj.formState);
        showNotification('Объект загружен для редактирования', 'info');
        currentCalcReady = false;
        // прокрутка к началу страницы
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

