  items.forEach(it => {
    const tr = document.createElement('tr');
    tr.className = '__area__';
    tr.innerHTML = `
      <td>
        <div style="font-weight:600;">Руст</div>
        <div class="badge">${formatNumber(it.A_cm,0)}×${formatNumber(it.B_cm,0)} см</div>
      </td>
      <td class="text-center font-mono">—</td>
      <td class="text-center font-mono">м²</td>
      <td class="text-right font-mono">${formatNumber(it.qty)}</td>
      <td class="text-center font-mono">—</td>
      <td class="text-right font-mono">${formatNumber(it.area_m2 * it.qty, 3)}</td>
      <td class="text-right font-mono">${formatNumber(it.pricePerItem)}</td>
      <td class="text-right font-mono" style="font-weight:700;">${formatCurrency(it.total)}</td>
    `;
    tbody.appendChild(tr);
  });
  // Обновляем футер по текущей таблице
  updateFooterTotalFromTable();
  // После обновления таблицы обновляем стик-панель
  try {
    renderStickSmeta(items);
  } catch(e) {}
}

/**
 * Пересчитывает суммарную стоимость по всем строкам и обновляет футер #resultsFooter.
 * Использует значения последнего столбца каждой строки таблицы.
 */
function updateFooterTotalFromTable(){
  const tfoot = document.getElementById('resultsFooter');
  if (!tfoot) return;
  let sum = 0;
  document.querySelectorAll('#resultsTable tbody tr td:last-child').forEach(td => {
    // Извлекаем число, заменяя запятые и пробелы
    let val = String(td.textContent).replace(/[^\d,\.]/g,'').replace(',', '.');
    let num = parseFloat(val);
    if (!isNaN(num)) sum += num;
  });
  // Формируем футер
  tfoot.innerHTML = `
    <tr class="total-grand">
      <td colspan="7" class="text-right" style="color:#fff;font-weight:700;font-size:17px">🎯 ОБЩАЯ СТОИМОСТЬ:</td>
      <td class="text-right font-mono" style="color:#fff;font-weight:700;font-size:17px">${formatCurrency(sum)}</td>
