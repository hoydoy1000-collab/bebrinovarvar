  <script>
    // ==================== ПОЛНЫЙ ПРАЙС-ЛИСТ 2025 ГОДА ====================
    const THICK_STEPS_MM = [30,50,70,100,120,150,170,200,220,250,270,300,320,350,370,400,420,450,470,500];
// Прайс‑лист 2025 (руб/м.п.)
const RAW_PRICE_2025 = {
  80:  [688, 822, 942],
  100: [801, 942, 1130, 1337],
