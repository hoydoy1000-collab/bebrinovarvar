<script>
    // ----- Remove mini table in stick-mode overlay (remove interfering table) -----
    (function() {
      /**
       * Completely remove the temporary mini estimate table from the stick-mode
       * overlay. This table shows a preview of the piece formula but interferes
       * with the cleaner UI requested by the user. Removing it entirely
       * eliminates layout issues instead of merely hiding it.
       */
      function removeMiniTable() {
        var t = document.getElementById('stickMiniTable');
        if (t && t.parentNode) {
          t.parentNode.removeChild(t);
        }
      }
      // Try to remove the table immediately in case it's already present.
      removeMiniTable();
      // Observe DOM changes and remove the table whenever it is added in the future.
      var obs = new MutationObserver(function() { removeMiniTable(); });
      obs.observe(document.body, { childList: true, subtree: true });
    })();

    // ----- Extend clearProject to also clear Rust items -----
    (function() {
      var origClear = window.clearProject;
      if (typeof origClear === 'function' && !origClear.__rustPatched) {
        window.clearProject = function() {
          try {
            if (window.appState && window.appState.areaItems) {
              window.appState.areaItems = [];
            }
            try { localStorage.removeItem('fasad_rust'); } catch(e){}
            try { localStorage.removeItem('facade_area_items'); } catch(e){}
            if (typeof renderAreaSmeta === 'function') renderAreaSmeta([]);
            if (typeof renderStickSmeta === 'function') renderStickSmeta([]);
          } catch(e){}
          return origClear.apply(this, arguments);
        };
        window.clearProject.__rustPatched = true;
      }
    })();

    // ----- Modal for listing Rust items -----
    (function() {
      window.openRustModal = function() {
        var ov = document.getElementById('rustModalOverlay');
        var listEl = document.getElementById('rustModalList');
        var totalEl = document.getElementById('rustModalTotal');
        if (!ov || !listEl || !totalEl) return;
        var items = (window.appState && window.appState.areaItems) || [];
        listEl.innerHTML = '';
        var total = 0;
        if (!items.length) {
          listEl.innerHTML = '<div style="opacity:.7;">Нет добавленных элементов.</div>';
        } else {
          items.forEach(function(it) {
            // Ensure item has a name; fallback to "Руст"
            if (!it.name) it.name = 'Руст';
            total += Number(it.total) || 0;
            var row = document.createElement('div');
            row.className = 'rust-modal-item';
            row.innerHTML = `\n              <div>\n                <div style="font-weight:600;">${it.name}</div>\n                <div class="badge">A×B: ${formatNumber(it.A_cm,0)}×${formatNumber(it.B_cm,0)} см</div>\n              </div>\n              <div style="text-align:right;">\n                ${formatCurrency(it.total)}<br>\n                <span style="opacity:.7;">${formatNumber(it.qty)} шт · ${Number(it.area_m2 || 0).toFixed(3)} м²</span>\n              </div>\n              <div>\n                <button class="danger" data-remove-id="${it.id}" style="padding:6px 10px;border-radius:6px;border:none;background:#f87171;color:#fff;font-size:12px;cursor:pointer;">Удалить</button>\n              </div>\n            `;
            listEl.appendChild(row);
          });
        }
        totalEl.textContent = 'ИТОГО: ' + formatCurrency(total);
        ov.style.display = 'flex';
      };
      window.closeRustModal = function() {
        var ov = document.getElementById('rustModalOverlay');
        if (ov) ov.style.display = 'none';
      };
      window.clearRustItems = function() {
        if (window.appState && window.appState.areaItems) {
          window.appState.areaItems = [];
        }
        try { localStorage.removeItem('fasad_rust'); } catch(e){}
        try { localStorage.removeItem('facade_area_items'); } catch(e){}
        if (typeof renderAreaSmeta === 'function') renderAreaSmeta([]);
        if (typeof renderStickSmeta === 'function') renderStickSmeta([]);
        window.closeRustModal();
      };
      document.addEventListener('click', function(e) {
        var t = e.target;
        if (!t) return;
        if (t.id === 'rustModalCloseBtn') {
          closeRustModal();
        } else if (t.id === 'rustModalClearBtn') {
          clearRustItems();
        } else if (t.id === 'rustModalAddBtn') {
          closeRustModal();
          if (typeof launchAreaModal === 'function') {
            launchAreaModal();
          }
        } else if (t.hasAttribute('data-remove-id')) {
          var id = t.getAttribute('data-remove-id');
          if (window.appState && window.appState.areaItems) {
            window.appState.areaItems = window.appState.areaItems.filter(function(item){ return item.id !== id; });
            try { localStorage.setItem('fasad_rust', JSON.stringify(window.appState.areaItems)); } catch(e){}
            if (typeof renderAreaSmeta === 'function') renderAreaSmeta(window.appState.areaItems);
            if (typeof renderStickSmeta === 'function') renderStickSmeta(window.appState.areaItems);
            openRustModal();
          }
        }
      });

      // Also hook clicks on any "Очистить проект" button so that rust items are cleared.
      // The core application may call clearProject() or reload the page, but the
      // Rust items need to be purged from localStorage and state beforehand.
      document.addEventListener('click', function(evt) {
        var btn = evt.target && evt.target.closest('button,a');
        if (!btn) return;
        var txt = (btn.textContent || '').trim();
        // Match by label or common identifiers
        if (/очистить проект/i.test(txt) || btn.dataset.action === 'clear-project' || btn.id === 'clear_project') {
          if (typeof window.clearRustItems === 'function') {
            window.clearRustItems();
          }
        }
      });
    })();
  </script>
