              <td class="text-right font-mono" style="font-weight: 700; color: var(--success);">${formatCurrency(item.sum)}</td>
            </tr>
          `;
        });
      }
      
      // РАБОТЫ
      if (workItems.length > 0) {
        html += `<tr class="section-header work"><td colspan="8">🔨 МОНТАЖНЫЕ РАБОТЫ</td></tr>`;
        
        workItems.forEach(item => {
          html += `
            <tr class="element-work">
              <td>
                <div style="font-weight: 600; margin-bottom: 4px;">${item.name}</div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <span class="badge badge-work">${item.unit.toUpperCase()}</span>
                </div>
              </td>
              <td class="text-center font-mono" style="font-weight: 600;">${item.size}</td>
              <td class="text-center" style="font-weight: 600; color: var(--work-color);">${item.unit}</td>
              <td class="text-right font-mono">${formatNumber(item.qty)}</td>
              <td class="text-right font-mono">${item.totalLength > 0 ? formatNumber(item.totalLength, 0) : '—'}</td>
              <td class="text-right font-mono">${item.meters > 0 ? formatNumber(item.meters, 3) : '—'}</td>
              <td class="text-right font-mono">${formatNumber(item.unitPrice)}</td>
              <td class="text-right font-mono" style="font-weight: 700; color: var(--work-color);">${formatCurrency(item.sum)}</td>
            </tr>
          `;
        });
      }
      
      tbody.innerHTML = html;
      
      // ИТОГОВЫЕ СТРОКИ
      footer.innerHTML = `
        <tr class="total-materials">
          <td colspan="7" class="text-right" style="color: white; font-weight: 700; font-size: 15px;">
            💰 ИТОГО МАТЕРИАЛЫ:
          </td>
          <td class="text-right font-mono" style="color: white; font-weight: 700; font-size: 15px;">
            ${formatCurrency(materialTotal)}
          </td>
        </tr>
        <tr class="total-work">
          <td colspan="7" class="text-right" style="color: white; font-weight: 700; font-size: 15px;">
            🔨 ИТОГО РАБОТЫ:
          </td>
          <td class="text-right font-mono" style="color: white; font-weight: 700; font-size: 15px;">
            ${formatCurrency(workTotal)}
          </td>
        </tr>
        <tr class="total-grand">
          <td colspan="7" class="text-right" style="color: white; font-weight: 700; font-size: 17px;">
            🎯 ОБЩАЯ СТОИМОСТЬ:
          </td>
          <td class="text-right font-mono" style="color: white; font-weight: 700; font-size: 17px;">
            ${formatCurrency(grandTotal)}
          </td>
        </tr>
      `;
      
      count.textContent = `${materialItems.length + workItems.length} позиций`;
      footer.classList.remove('hidden');
      
      ['excelBtn', 'pdfBtn'].forEach(id => {
        document.getElementById(id).classList.remove('hidden');
      });
      
      calculationResults = { 
        items: [...materialItems, ...workItems], 
        materialItems, 
        workItems, 
        materialTotal, 
        workTotal, 
        total: grandTotal 
      };
    }

    function exportResults() {
      if (!calculationResults || typeof XLSX === 'undefined') {
        showNotification('Сначала выполните расчёт или библиотека не загружена', 'error');
        return;
      }
      
      const allData = [
        // Материалы
        ...calculationResults.materialItems.map(item => ({
          'Раздел': 'МАТЕРИАЛЫ',
          'Наименование': item.name,
          'Размер H×W×T': item.size,
          'Единица': item.unit,
          'Количество': item.qty,
          'Длина (мм)': item.totalLength,
          'Метры п.': item.meters,
          'Цена/ед (₽)': item.unitPrice,
          'Сумма (₽)': item.sum,
          'Режим': item.mode === 'auto' ? 'АВТО' : 'РУЧНОЙ'
        })),
        // Работы
        ...calculationResults.workItems.map(item => ({
          'Раздел': 'РАБОТЫ',
          'Наименование': item.name,
          'Размер H×W×T': item.size,
          'Единица': item.unit,
          'Количество': item.qty,
          'Длина (мм)': item.totalLength || '—',
          'Метры п.': item.meters || '—',
          'Цена/ед (₽)': item.unitPrice,
          'Сумма (₽)': item.sum,
          'Режим': '—'
        })),
        // Итоги
