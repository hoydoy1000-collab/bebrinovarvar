                <div class="form-group"><label class="form-label">Ставка (₽/м²)</label><input id="areaRate" type="number" class="swal2-input" value="${defaultRate}" min="0" step="100"></div>
              </div>
            `,
            focusConfirm: false,
            showCancelButton: true,
            confirmButtonText: 'Рассчитать',
            preConfirm: () => {
              const A = parseFloat(document.getElementById('areaA').value) || 0;
              const B = parseFloat(document.getElementById('areaB').value) || 0;
              const qty = parseFloat(document.getElementById('areaQty').value) || 0;
              const rate = parseFloat(document.getElementById('areaRate').value) || 0;
              if (A <= 0 || B <= 0 || qty <= 0 || rate <= 0) {
                Swal.showValidationMessage('Введите корректные значения A, B, количества и ставки');
                return false;
              }
              return { A, B, qty, rate };
            }
          }).then((result) => {
            if (!result.isConfirmed || !result.value) return;
            const { A, B, qty, rate } = result.value;
            const pricePerItem = (A * B * rate) / 10000;
            const total = pricePerItem * qty;
            const msg = `
              📐 Площадь: ${A} × ${B} мм × ${qty} шт<br>
              Ставка: ${formatNumber(rate, 0)} ₽/м²<br>
              Цена за изделие: ${formatCurrency(pricePerItem)}<br>
              Итог: ${formatCurrency(total)}
            `;
            showNotification(msg, 'info');
            // После расчёта сразу добавляем результат в таблицу сметы
            try {
              insertAreaResult(A, B, qty, rate);
            } catch (e) {
              console.warn('Unable to insert area result', e);
            }
          });
        } else {
          // fallback на простые prompt/alert
          const A = parseFloat(prompt('A (мм):', defaultA)) || 0;
          const B = parseFloat(prompt('B (мм):', defaultB)) || 0;
          const qty = parseFloat(prompt('Количество (шт):', defaultQty)) || 0;
          const rate = parseFloat(prompt('Ставка (₽/м²):', defaultRate)) || 0;
          if (A <= 0 || B <= 0 || qty <= 0 || rate <= 0) {
            alert('Некорректные значения для площади');
            return;
          }
          const pricePerItem = (A * B * rate) / 10000;
          const total = pricePerItem * qty;
          alert('Цена за изделие: ' + formatCurrency(pricePerItem) + '\nИтог: ' + formatCurrency(total));
          // В консоль: добавляем результат в таблицу сметы
          try {
            insertAreaResult(A, B, qty, rate);
          } catch (e) {
            console.warn('Unable to insert area result', e);
          }
        }
      }

      // Добавить новую штучную позицию
      function addPieceItem() {
        const name = (document.getElementById('piece_name').value || '').trim();
        // raw strings from inputs; fallback to placeholder if value is empty
        const wEl = document.getElementById('piece_width');
        const tEl = document.getElementById('piece_thickness');
        const lenEl = document.getElementById('piece_length');
        const qtyEl = document.getElementById('piece_qty');
        const wRaw = ((wEl && wEl.value) ? wEl.value : (wEl?.placeholder || '')).toString().trim();
        const tRaw = ((tEl && tEl.value) ? tEl.value : (tEl?.placeholder || '')).toString().trim();
        const lenRaw = ((lenEl && lenEl.value) ? lenEl.value : (lenEl?.placeholder || '')).toString().trim();
        const qtyRaw = ((qtyEl && qtyEl.value) ? qtyEl.value : (qtyEl?.placeholder || '')).toString().trim();
        // validate name
        if (!name) {
          showNotification('Укажите название штучной детали', 'error');
          return;
        }
        // ensure numeric fields are provided for length and quantity
        if (!lenRaw) {
          showNotification('Укажите длину одной детали (м.п.)', 'error');
          return;
        }
        if (!qtyRaw) {
          showNotification('Укажите количество (шт)', 'error');
          return;
        }
        // convert to numbers; support comma as decimal separator
        let w = parseFloat(wRaw.replace(',', '.'));
        let t = parseFloat(tRaw.replace(',', '.'));
        const len = parseFloat(lenRaw.replace(',', '.'));
        const qty = parseInt(qtyRaw, 10);
        // if width or thickness are missing or invalid, set sensible defaults
        if (!wRaw || isNaN(w) || w <= 0) {
          w = 80;
        }
        if (!tRaw || isNaN(t) || t <= 0) {
          t = 20;
        }
        // validate length and quantity
        if (isNaN(len) || len <= 0) {
          showNotification('Длина должна быть > 0', 'error');
          return;
        }
        if (isNaN(qty) || qty <= 0) {
          showNotification('Количество должно быть > 0', 'error');
          return;
        }
        // получаем цену за м.п. по прайсу
        const priceData = lookupPrice(w, t);
        const price = (priceData && priceData.p) ? priceData.p : 500;
        const total = price * len * qty;
        const item = {
          id: 'piece_' + Math.random().toString(36).substr(2, 9),
          name,
          width: w,
          thickness: t,
          length: len,
          qty,
          pricePerM: price,
          total
        };
        pieceItems.push(item);
        renderPieceList();
        saveAppState();
        // очищаем поля для удобства
        document.getElementById('piece_name').value = '';
        document.getElementById('piece_width').value = '';
        document.getElementById('piece_thickness').value = '';
        document.getElementById('piece_length').value = '';
        document.getElementById('piece_qty').value = '1';
        // уведомление об успехе
        showNotification('Штучная деталь добавлена', 'success');
      }

