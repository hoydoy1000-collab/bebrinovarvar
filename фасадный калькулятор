/* === Стик-панель для «Рустов» === */
#stick_panel {
  position: fixed;
  right: 20px;
  bottom: 92px;
  z-index: 2147483647;
  /* скрываем плавающую панель «Руст», она больше не нужна */
  display: none !important;
}
#stick_panel.hidden {
  display: none;
}
.stick-card {
  min-width: 260px;
  max-width: 340px;
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 10px 30px rgba(0,0,0,.12);
  overflow: hidden;
  font-size: 14px;
}
.stick-head {
  padding: 10px 14px;
  font-weight: 700;
  background: rgba(25,118,210,.08);
  border-left: 3px solid var(--primary);
}
.stick-list {
  padding: 8px 12px;
  max-height: 50vh;
  overflow: auto;
}
.stick-item {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
  padding: 6px 0;
  border-bottom: 1px dashed #e5e7eb;
}
.stick-item:last-child {
  border-bottom: none;
}
.stick-foot {
  padding: 10px 14px;
  background: linear-gradient(180deg, #1e3a8a, #1d4ed8);
  color: #fff;
  font-weight: 700;
  text-align: right;
}
</style>
  <style>
    /* ==== Added by enhanced script for better alignment ==== */
