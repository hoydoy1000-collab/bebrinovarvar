       * Выключенные элементы блокируют поля ручного ввода и визуально приглушаются.
       */
      function updateDetailEnabledUI(detail) {
        // блок с ручными входами
        const manualInputs = document.getElementById(`${detail}_manual_inputs`);
        const autoFields = document.getElementById(`${detail}_auto_fields`);
        const miterGroup = document.getElementById(`${detail}_angle_group`) || document.getElementById(`${detail}_angle_cut`);
        // найти все инпуты, относящиеся к элементу
        const inputs = manualInputs ? manualInputs.querySelectorAll('input, select') : [];
        const cb = document.getElementById(`enable_${detail}`);
        const enabled = detailEnabled[detail];
        // затемнить и отключить
        if (manualInputs) {
          if (enabled) {
            manualInputs.style.opacity = '';
            inputs.forEach(el => el.disabled = false);
          } else {
            manualInputs.style.opacity = '0.5';
            inputs.forEach(el => el.disabled = true);
          }
        }
        if (autoFields) {
          // тоже приглушаем авто поля, хотя авто режим будет скрыт
          autoFields.style.opacity = enabled ? '' : '0.5';
        }
        // м/запилы
        if (miterGroup && miterGroup.parentElement) {
          if (enabled) {
            miterGroup.parentElement.style.opacity = '';
            miterGroup.parentElement.querySelectorAll('input').forEach(el => el.disabled = false);
          } else {
            miterGroup.parentElement.style.opacity = '0.5';
            miterGroup.parentElement.querySelectorAll('input').forEach(el => el.disabled = true);
          }
        }
      }

      /**
       * Принудительно устанавливает для всех элементов ручной режим и скрывает авто-переключатели.
       * Это выполняется один раз после загрузки страницы, чтобы убрать режим «авто».
       */
      function applyManualMode() {
        // для каждого элемента
        ['trim','cornice','sill'].forEach(detail => {
          // устанавливаем режим manual
          if (detailModes && detailModes[detail]) {
            detailModes[detail] = 'manual';
          }
          // скрываем переключатель режима
          const toggleWrapper = document.getElementById(`${detail}_mode_toggle`)?.parentElement;
          if (toggleWrapper) {
            toggleWrapper.style.display = 'none';
          }
          // скрываем авто-поля
          const autoFields = document.getElementById(`${detail}_auto_fields`);
          if (autoFields) autoFields.style.display = 'none';
          // показываем ручные поля
          const manualInputs = document.getElementById(`${detail}_manual_inputs`);
          if (manualInputs) {
            manualInputs.style.display = 'block';
            manualInputs.classList.add('visible');
          }
          // обновляем подпись режима, если есть
          const label = document.getElementById(`${detail}_mode_label`);
          if (label) {
            label.textContent = '✏️ РУЧНОЙ';
            label.style.color = 'var(--info)';
          }
          // удаляем возможность клика по toggle
          const toggle = document.getElementById(`${detail}_mode_toggle`);
          if (toggle) {
            toggle.onclick = null;
          }
        });
      }

