        showNotification('Форма сброшена. Можно создавать новый объект.', 'success');

        // включить все элементы по умолчанию
        detailEnabled.trim = true;
        detailEnabled.cornice = true;
        detailEnabled.sill = true;
        // обновить UI для включения элементов
