        // скрываем результаты
        const tbody = document.querySelector('#resultsTable tbody');
        if (tbody) {
          tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:40px; color: var(--text-muted); font-size:16px;">🧮 Нажмите \"Рассчитать смету\" для получения полного расчёта</td></tr>`;
        }
