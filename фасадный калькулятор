  // Update the small preview next to the select whenever the select changes
  async function updateSelectPreview() {
    const select = document.getElementById('kind_simple');
    const preview = document.getElementById('kind_thumb_preview');
    if (!select || !preview) return;
    const value = select.value || select.options[0]?.value;
    const id = (value.match(/\d+/) || ['1'])[0];
    const src = await findImageForType(id);
    preview.src = src;
    preview.alt = `Тип ${id}`;
