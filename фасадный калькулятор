          trimName = `Наличник h${data.trimHeight}×${data.trimWidth}×${data.trimThickness}${trimHasMiter ? ' с боковыми запилами в сборе' : ''}`;
        } else {
          const manualWidth = parseFloat(document.getElementById('manual_trim_width').value) || 80;
          const manualThickness = parseFloat(document.getElementById('manual_trim_thickness').value) || 20;
          const manualHeight = parseFloat(document.getElementById('manual_trim_height').value) || 1300;
          trimData = {
            width: manualWidth,
            thickness: manualThickness,
            height: manualHeight,
            // Количество умножается на число проёмов
            qty: (parseFloat(document.getElementById('manual_trim_qty').value) || 2) * data.count
          };
          trimName = `Наличник h${manualHeight}×${manualWidth}×${manualThickness}${trimHasMiter ? ' с боковыми запилами в сборе' : ''} (ручной)`;
        }

        // === Коррекция размеров наличника для типа 1 ===
        // Для типа 1 наличник состоит из двух вертикальных стоек и одной верхней планки.
        // Формула: Ln = 2·B + A + 4·C. Длина одной стойки = B + 2·C, длина верхней планки = A.
        if (data.openingType === 'type1') {
          try {
            const A_mm = data.openingWidth;
            const B_mm = data.openingHeight;
            // Получаем ширину наличника C из блока type1 или из ручных полей
            let C_mm = null;
            const cField = document.getElementById('type1_trim_width');
            if (cField && cField.value) {
              C_mm = parseFloat(cField.value);
            }
            if (!C_mm || isNaN(C_mm)) {
              const manualCEl = document.getElementById('manual_trim_width');
              if (manualCEl && manualCEl.value) {
                C_mm = parseFloat(manualCEl.value);
              }
            }
            if (C_mm && !isNaN(C_mm)) {
              trimData.width = C_mm;
              // Толщина наличника
              let T_mm = null;
              const tField = document.getElementById('type1_trim_thickness');
              if (tField && tField.value) {
                T_mm = parseFloat(tField.value);
              }
              if (!T_mm || isNaN(T_mm)) {
                const manualTT = document.getElementById('manual_trim_thickness');
                if (manualTT && manualTT.value) {
                  T_mm = parseFloat(manualTT.value);
                }
              }
              if (T_mm && !isNaN(T_mm)) {
                trimData.thickness = T_mm;
              }
              // Очищаем базовые данные: высота и количество будут заданы при добавлении деталей ниже
              trimData.height = 0;
              trimData.qty = 0;
              trimName = '';
            }
          } catch (e) {
            // ignore errors
          }
        }

        // === Обработка камней и кронштейнов для типов 4 и 5 ===
        if (data.openingType === 'type4' || data.openingType === 'type5') {
          try {
            // Определяем ширину (C) и толщину (T) наличника для типов 4 и 5
            let C_tt = trimData.width;
            let T_tt = trimData.thickness;
            if (data.openingType === 'type4') {
              const c4 = document.getElementById('type4_trim_width');
              if (c4 && c4.value) {
                const tmp = parseFloat(c4.value);
                if (!isNaN(tmp)) C_tt = tmp;
              }
              const t4 = document.getElementById('type4_trim_thickness');
              if (t4 && t4.value) {
                const tmp = parseFloat(t4.value);
                if (!isNaN(tmp)) T_tt = tmp;
              }
            } else if (data.openingType === 'type5') {
              const c5 = document.getElementById('type5_trim_width');
              if (c5 && c5.value) {
                const tmp = parseFloat(c5.value);
                if (!isNaN(tmp)) C_tt = tmp;
              }
              const t5 = document.getElementById('type5_trim_thickness');
              if (t5 && t5.value) {
                const tmp = parseFloat(t5.value);
                if (!isNaN(tmp)) T_tt = tmp;
              }
            }
            // Если значения не заданы, подставляем из ручных настроек
            if (!C_tt || isNaN(C_tt)) {
              const manualCtt = document.getElementById('manual_trim_width');
              if (manualCtt && manualCtt.value) {
                const tmp = parseFloat(manualCtt.value);
                if (!isNaN(tmp)) C_tt = tmp;
              }
            }
            if (!T_tt || isNaN(T_tt)) {
              const manualTtt = document.getElementById('manual_trim_thickness');
              if (manualTtt && manualTtt.value) {
                const tmp = parseFloat(manualTtt.value);
                if (!isNaN(tmp)) T_tt = tmp;
              }
            }
            // Обновляем trimData для корректного расчёта цены
            if (C_tt && !isNaN(C_tt)) trimData.width = C_tt;
            if (T_tt && !isNaN(T_tt)) trimData.thickness = T_tt;
            // Считываем высоту камня F и высоту кронштейна G
            let F_tt = 0;
            let G_tt = 0;
            if (data.openingType === 'type4') {
              const f4 = document.getElementById('type4_stone_height');
              if (f4 && f4.value) {
                const tmp = parseFloat(f4.value);
                if (!isNaN(tmp)) F_tt = tmp;
              }
            } else if (data.openingType === 'type5') {
              const f5 = document.getElementById('type5_stone_height');
              if (f5 && f5.value) {
                const tmp = parseFloat(f5.value);
                if (!isNaN(tmp)) F_tt = tmp;
              }
              const g5 = document.getElementById('type5_bracket_height');
              if (g5 && g5.value) {
                const tmp = parseFloat(g5.value);
                if (!isNaN(tmp)) G_tt = tmp;
              }
            }
            // Добавляем камни (вставки) если высота F > 0
            if (F_tt > 0) {
              // Расчёт для камней (вставок) по объёму: высота + припуск (мм) * ширина наличника (мм) * толщина (см)
              let stoneTotal = F_tt + data.reveal;
              stoneTotal += stoneTotal * (wastePercent / 100) + cuttingAllowance;
              const qtyStone = 2 * data.count;
              // Толщина камня в см и ставка, зависят от типа
              let stoneThickCm = 8;
              let stoneRate = 50000;
              if (data.openingType === 'type4') {
                const tEl = document.getElementById('type4_stone_thickness_cm');
                const rEl = document.getElementById('type4_stone_rate');
                const tVal = parseFloat(tEl?.value);
                const rVal = parseFloat(rEl?.value);
                if (!isNaN(tVal)) stoneThickCm = tVal;
                if (!isNaN(rVal)) stoneRate = rVal;
              } else if (data.openingType === 'type5') {
                const tEl5 = document.getElementById('type5_stone_thickness_cm');
                const rEl5 = document.getElementById('type5_stone_rate');
                const tVal5 = parseFloat(tEl5?.value);
                const rVal5 = parseFloat(rEl5?.value);
                if (!isNaN(tVal5)) stoneThickCm = tVal5;
                if (!isNaN(rVal5)) stoneRate = rVal5;
              }
              // Перевод размеров в метры: высоту (stoneTotal) и ширину наличника в мм -> м, толщину в см -> м
              const stoneVolumePerPiece = (stoneTotal / 1000) * (trimData.width / 1000) * (stoneThickCm / 100);
              const stoneVolume = stoneVolumePerPiece * qtyStone;
              const stoneUnitPrice = stoneRate;
              const stoneSum = stoneVolume * stoneUnitPrice;
              materialItems.push({
                name: 'Камни (вставки)',
                size: `h${F_tt}×${trimData.width}×${(stoneThickCm * 10).toFixed(0)}`,
                unit: 'м³',
                qty: qtyStone,
                baseLength: F_tt,
                totalLength: stoneTotal * qtyStone,
                meters: stoneVolume,
                unitPrice: stoneUnitPrice,
                sum: stoneSum,
                type: 'material',
                hasMiter: false,
                mode: detailModes.trim
              });
            }
            // Добавляем кронштейны (вставки) для Типа 5 если высота G > 0
            if (data.openingType === 'type5' && G_tt > 0) {
              // Расчёт для кронштейнов (вставок) по объёму
              let bracketTotal = G_tt + data.reveal;
              bracketTotal += bracketTotal * (wastePercent / 100) + cuttingAllowance;
              const qtyBrackets = 2 * data.count;
              let stoneThickCm = 8;
              let stoneRate = 50000;
              {
                const tEl5 = document.getElementById('type5_stone_thickness_cm');
                const rEl5 = document.getElementById('type5_stone_rate');
                const tVal5 = parseFloat(tEl5?.value);
                const rVal5 = parseFloat(rEl5?.value);
                if (!isNaN(tVal5)) stoneThickCm = tVal5;
                if (!isNaN(rVal5)) stoneRate = rVal5;
              }
              const bracketVolumePerPiece = (bracketTotal / 1000) * (trimData.width / 1000) * (stoneThickCm / 100);
              const bracketVolume = bracketVolumePerPiece * qtyBrackets;
              const bracketUnitPrice = stoneRate;
              const bracketSum = bracketVolume * bracketUnitPrice;
              materialItems.push({
                name: 'Кронштейны (вставки)',
                size: `h${G_tt}×${trimData.width}×${(stoneThickCm * 10).toFixed(0)}`,
                unit: 'м³',
                qty: qtyBrackets,
                baseLength: G_tt,
                totalLength: bracketTotal * qtyBrackets,
                meters: bracketVolume,
                unitPrice: bracketUnitPrice,
                sum: bracketSum,
                type: 'material',
                hasMiter: false,
                mode: detailModes.trim
              });
            }
          } catch (e) {
            // ignore errors
          }
        }

        // === Коррекция размеров наличника для типа 2 ===
        // Для типа 2 наличник также состоит из двух вертикальных стоек и одной верхней планки. Чтобы избежать
        // добавления базовой строки для наличника, обнуляем высоту и количество, а также уточняем размеры
        // наличника по полям типа 2. Затем отдельные стойки/планки будут добавлены ниже.
        if (data.openingType === 'type2') {
          try {
            const A_mm = data.openingWidth;
            const B_mm = data.openingHeight;
            // Получаем ширину и толщину наличника из блока type2 или из ручных настроек
            let C2_mm = null;
            let T2_mm = null;
            const cField2 = document.getElementById('type2_trim_width');
            const tField2 = document.getElementById('type2_trim_thickness');
            if (cField2 && cField2.value) C2_mm = parseFloat(cField2.value);
            if (tField2 && tField2.value) T2_mm = parseFloat(tField2.value);
            if (!C2_mm || isNaN(C2_mm)) {
              const manualC2 = document.getElementById('manual_trim_width');
              if (manualC2 && manualC2.value) C2_mm = parseFloat(manualC2.value);
            }
            if (!T2_mm || isNaN(T2_mm)) {
              const manualT2 = document.getElementById('manual_trim_thickness');
              if (manualT2 && manualT2.value) T2_mm = parseFloat(manualT2.value);
            }
            if (C2_mm && !isNaN(C2_mm)) {
              trimData.width = C2_mm;
            }
            if (T2_mm && !isNaN(T2_mm)) {
              trimData.thickness = T2_mm;
            }
            // Сбрасываем базовую высоту и количество, чтобы не добавлять строку base trim
            trimData.height = 0;
            trimData.qty = 0;
            trimName = '';
          } catch (e) {
            // ignore errors
          }
        }

          // === Коррекция длины и толщины подоконника для типа 3 ===
          if (data.openingType === 'type3') {
            try {
              const A_mm3 = data.openingWidth;
              // C: ширина наличника для типа 3
              let C_mm3 = null;
              const c3Field = document.getElementById('type3_trim_width');
              if (c3Field && c3Field.value) {
                C_mm3 = parseFloat(c3Field.value);
              }
              if (!C_mm3 || isNaN(C_mm3)) {
                const manualC3El = document.getElementById('manual_trim_width');
                if (manualC3El && manualC3El.value) {
                  C_mm3 = parseFloat(manualC3El.value);
                }
              }
              // E: толщина подоконника (для типа 3 это толщина подоконника)
              let E_mm3 = null;
              const e3Field = document.getElementById('type3_sill_thickness');
              if (e3Field && e3Field.value) {
                E_mm3 = parseFloat(e3Field.value);
              }
              if (!E_mm3 || isNaN(E_mm3)) {
                const manualE3El = document.getElementById('manual_sill_thickness');
                if (manualE3El && manualE3El.value) {
                  E_mm3 = parseFloat(manualE3El.value);
                }
              }
              if (C_mm3 && E_mm3 && !isNaN(C_mm3) && !isNaN(E_mm3)) {
                const Lp_mm3 = A_mm3 + 2 * C_mm3 + 10 + 2 * E_mm3;
                sillData.length = Lp_mm3;
                sillData.thickness = E_mm3;
                // Ширина подоконника берётся из поля type3_sill_width или из ручных настроек
                let W_mm3 = null;
                const w3Field = document.getElementById('type3_sill_width');
                if (w3Field && w3Field.value) {
                  W_mm3 = parseFloat(w3Field.value);
                }
                if (!W_mm3 || isNaN(W_mm3)) {
                  const manualSW3 = document.getElementById('manual_sill_width');
                  if (manualSW3 && manualSW3.value) {
                    W_mm3 = parseFloat(manualSW3.value);
                  }
                }
                if (W_mm3 && !isNaN(W_mm3)) {
                  sillData.width = W_mm3;
                }
                // Обновляем имя подоконника, чтобы отражать новые размеры для типа 3
                sillName = `Подоконник h${sillData.thickness}×${sillData.width}×${sillData.depth}${sillHasMiter ? ' с боковыми запилами в сборе' : ''}`;
              }
            } catch (e) {
              // ignore errors
            }
          }

        // === Коррекция размеров наличника для типа 3 ===
        // Для типа 3 наличник состоит из двух вертикальных стоек. Верхняя планка
        // является карнизом, поэтому базовая строка наличника не должна добавляться.
        // Мы берём ширину и толщину наличника из блока type3 (или из ручных настроек),
        // затем сбрасываем базовую высоту и количество, чтобы не добавлять строку
        // base trim. Отдельные стойки и карниз будут добавлены ниже.
        if (data.openingType === 'type3') {
          try {
            const A_mm = data.openingWidth;
            const B_mm = data.openingHeight;
            // Получаем ширину и толщину наличника из блока type3
            let C3_mm = null;
            let T3_mm = null;
            const cField3 = document.getElementById('type3_trim_width');
            const tField3 = document.getElementById('type3_trim_thickness');
            if (cField3 && cField3.value) C3_mm = parseFloat(cField3.value);
            if (tField3 && tField3.value) T3_mm = parseFloat(tField3.value);
            if (!C3_mm || isNaN(C3_mm)) {
              const manualC3 = document.getElementById('manual_trim_width');
              if (manualC3 && manualC3.value) C3_mm = parseFloat(manualC3.value);
            }
            if (!T3_mm || isNaN(T3_mm)) {
              const manualT3 = document.getElementById('manual_trim_thickness');
              if (manualT3 && manualT3.value) T3_mm = parseFloat(manualT3.value);
            }
            if (C3_mm && !isNaN(C3_mm)) {
              trimData.width = C3_mm;
            }
            if (T3_mm && !isNaN(T3_mm)) {
              trimData.thickness = T3_mm;
            }
            // Очищаем базовые данные: высота и количество обнуляем,
            // чтобы не добавлять базовую строку.
            trimData.height = 0;
            trimData.qty = 0;
            trimName = '';
          } catch (e) {
            // ignore errors
          }
        }
        
        const trimMiterAdd = trimHasMiter ? calculateAngleMiterAddition(trimData.thickness, trimAngle, data.miterExtra) : 0;
        let trimTotalLength = trimData.height + trimMiterAdd + data.reveal;
        
        // Добавляем припуски
        const trimWasteAdd = trimTotalLength * (wastePercent / 100);
        trimTotalLength += trimWasteAdd + cuttingAllowance;
        
        const trimLookup = lookupPrice(trimData.width, trimData.thickness);
        const trimMeters = trimTotalLength / 1000;
        const trimSum = (typeof currency !== 'undefined')
          ? currency(trimMeters).multiply(trimData.qty).multiply(trimLookup.p).value
          : trimData.qty * trimMeters * trimLookup.p;
        
        // Добавляем позиции наличника
        if (data.openingType === 'type1') {
          /*
           * Для типа 1 наличник состоит из двух вертикальных стоек и одной верхней планки.
           * Согласно формуле Ln = 2·B + A + 4·C: каждая вертикаль имеет
           * базовую длину (B + 2·C), а верхняя планка — базовую длину A.
           * Мы не объединяем их в одну строчку; вместо этого добавляем
           * две отдельные позиции: «Наличник стойка» (qty = 2·count) и
           * «Наличник верх» (qty = 1·count). В каждом случае считаем
           * длину детали с отходами/припусками и умножаем на цену
           * прайса.
           */
          const A_mm = data.openingWidth;
          const B_mm = data.openingHeight;
          const C_mm = trimData.width;
          // Базовые длины (без отходов/припусков)
          // Для типа 1 вертикальная стойка имеет базовую длину B + C (припуск только сверху),
          // а верхняя планка — A + 2·C (припуск с двух сторон). Это следует из формулы
          // Ln = 2·B + A + 4·C = 2·(B+C) + (A + 2·C).
          const vertBase = B_mm + C_mm;
          const horizBase = A_mm + 2 * C_mm;
          // Длина вертикальной стойки с отходами и припусками
          let vertTotal = vertBase + trimMiterAdd + data.reveal;
          vertTotal += vertTotal * (wastePercent / 100) + cuttingAllowance;
          const vertMetersPerPiece = vertTotal / 1000;
          const vertPricePerPiece = vertMetersPerPiece * trimLookup.p;
          // Длина верхней планки с отходами и припусками
          let horizTotal = horizBase + trimMiterAdd + data.reveal;
          horizTotal += horizTotal * (wastePercent / 100) + cuttingAllowance;
          const horizMetersPerPiece = horizTotal / 1000;
          const horizPricePerPiece = horizMetersPerPiece * trimLookup.p;
          // Добавляем вертикальные стойки (2 шт на один проём)
          {
            const qty = 2 * data.count;
            // Общая длина и метры по всем стойкам
            const totalLength = vertTotal * qty;
            const totalMeters = vertMetersPerPiece * qty;
            // Для типа 1 мы считаем стоимость за одну деталь (шт), а не за метр,
            // поэтому unitPrice = цена за одну стойку (руб). В смете
            // отображаем количество стоек и цену за штуку.
            materialItems.push({
              name: `Наличник стойка`,
              size: `h${vertBase}×${trimData.width}×${trimData.thickness}`,
              unit: 'шт',
              qty: qty,
              baseLength: vertBase,
              totalLength: totalLength,
              meters: totalMeters,
              unitPrice: vertPricePerPiece,
              sum: ((typeof currency !== 'undefined') ? currency(vertPricePerPiece).multiply(qty).value : vertPricePerPiece * qty),
              type: 'material',
              hasMiter: trimHasMiter,
              mode: detailModes.trim
            });
          }
          // Добавляем верхнюю планку (1 шт на один проём)
          {
            const qty = 1 * data.count;
            const totalLength = horizTotal * qty;
            const totalMeters = horizMetersPerPiece * qty;
            // Для типа 1 верхняя планка также считается за штуку
            materialItems.push({
              name: `Наличник верх`,
              size: `h${horizBase}×${trimData.width}×${trimData.thickness}`,
              unit: 'шт',
              qty: qty,
              baseLength: horizBase,
              totalLength: totalLength,
              meters: totalMeters,
              unitPrice: horizPricePerPiece,
              sum: ((typeof currency !== 'undefined') ? currency(horizPricePerPiece).multiply(qty).value : horizPricePerPiece * qty),
              type: 'material',
              hasMiter: trimHasMiter,
              mode: detailModes.trim
            });
          }
        } else if (data.openingType !== 'type2' && data.openingType !== 'type3') {
          // Добавляем базовую строку наличника только для стандартного окна (не для типов 2 и 3)
          materialItems.push({
            name: trimName,
            size: `h${trimData.height}×${trimData.width}×${trimData.thickness}`,
            unit: 'мп',
            qty: trimData.qty,
            baseLength: trimData.height,
            totalLength: trimTotalLength,
            meters: trimMeters,
            unitPrice: trimLookup.p,
            sum: trimSum,
            type: 'material',
            hasMiter: trimHasMiter,
            mode: detailModes.trim
          });
        }

        // === Обработка наличника для Типа 2 ===
        if (data.openingType === 'type2') {
          try {
            const A_mm = data.openingWidth;
            const B_mm = data.openingHeight;
            // Извлекаем C и T из блока типа 2 или из ручных настроек
            let C_mm = null;
            let T_mm = null;
            const cField2 = document.getElementById('type2_trim_width');
            const tField2 = document.getElementById('type2_trim_thickness');
            if (cField2 && cField2.value) C_mm = parseFloat(cField2.value);
            if (tField2 && tField2.value) T_mm = parseFloat(tField2.value);
            if (!C_mm || isNaN(C_mm)) {
              const manualC = document.getElementById('manual_trim_width');
              if (manualC && manualC.value) C_mm = parseFloat(manualC.value);
            }
            if (!T_mm || isNaN(T_mm)) {
              const manualT = document.getElementById('manual_trim_thickness');
              if (manualT && manualT.value) T_mm = parseFloat(manualT.value);
            }
            if (C_mm && !isNaN(C_mm)) {
              trimData.width = C_mm;
            }
            if (T_mm && !isNaN(T_mm)) {
              trimData.thickness = T_mm;
            }
            // Получаем высоту камня F
            let F_mm = 0;
            const fField2 = document.getElementById('type2_stone_height');
            if (fField2 && fField2.value) {
              const fVal = parseFloat(fField2.value);
              if (!isNaN(fVal)) F_mm = fVal;
            }
            // Базовые длины (без отходов/припусков)
            // Для типа 2 вертикальная стойка имеет базовую длину (B − F) + 2·C.
            // Это соответствует формуле Ln = 2·(B − F + 2·C) + A.
            const vertBase2 = (B_mm - F_mm) + 2 * C_mm;
            // Верхняя планка: A (без припусков по ширине)
            const horizBase2 = A_mm;
            // Длина вертикальной стойки с отходами и припусками
            let vertTotal2 = vertBase2 + trimMiterAdd + data.reveal;
            vertTotal2 += vertTotal2 * (wastePercent / 100) + cuttingAllowance;
            const vertMetersPerPiece2 = vertTotal2 / 1000;
            const vertPricePerPiece2 = vertMetersPerPiece2 * trimLookup.p;
            // Длина верхней планки с отходами и припусками
            let horizTotal2 = horizBase2 + trimMiterAdd + data.reveal;
            horizTotal2 += horizTotal2 * (wastePercent / 100) + cuttingAllowance;
            const horizMetersPerPiece2 = horizTotal2 / 1000;
            const horizPricePerPiece2 = horizMetersPerPiece2 * trimLookup.p;
            // Добавляем вертикальные стойки (2 шт на один проём)
            {
              const qty2 = 2 * data.count;
              const totalLength2 = vertTotal2 * qty2;
              const totalMeters2 = vertMetersPerPiece2 * qty2;
              materialItems.push({
                name: `Наличник стойка`,
                size: `h${vertBase2}×${trimData.width}×${trimData.thickness}`,
                unit: 'шт',
                qty: qty2,
                baseLength: vertBase2,
                totalLength: totalLength2,
                meters: totalMeters2,
                unitPrice: vertPricePerPiece2,
                sum: ((typeof currency !== 'undefined') ? currency(vertPricePerPiece2).multiply(qty2).value : vertPricePerPiece2 * qty2),
                type: 'material',
                hasMiter: trimHasMiter,
                mode: detailModes.trim
              });
            }
            // Добавляем верхнюю планку (1 шт на один проём)
            {
              const qty2h = 1 * data.count;
              const totalLength2h = horizTotal2 * qty2h;
              const totalMeters2h = horizMetersPerPiece2 * qty2h;
              materialItems.push({
                name: `Наличник верх`,
                size: `h${horizBase2}×${trimData.width}×${trimData.thickness}`,
                unit: 'шт',
                qty: qty2h,
                baseLength: horizBase2,
                totalLength: totalLength2h,
                meters: totalMeters2h,
                unitPrice: horizPricePerPiece2,
                sum: ((typeof currency !== 'undefined') ? currency(horizPricePerPiece2).multiply(qty2h).value : horizPricePerPiece2 * qty2h),
                type: 'material',
                hasMiter: trimHasMiter,
                mode: detailModes.trim
              });
            }

            // Добавляем камни (вставки) для Типа 2, если указана высота камня F
            {
              const stoneHeight = F_mm || 0;
              if (stoneHeight > 0) {
                // Длина одного камня с припусками и отходами (без запилов)
                let stoneTotal = stoneHeight + data.reveal;
                stoneTotal += stoneTotal * (wastePercent / 100) + cuttingAllowance;
                const stoneMetersPerPiece = stoneTotal / 1000;
                // Цена за метр для камней — цена профиля наличника (trimLookup.p)
                const qtyStone = 2 * data.count;
                const stoneUnitPrice = trimLookup.p;
                const stoneSum = (typeof currency !== 'undefined')
                  ? currency(stoneMetersPerPiece).multiply(qtyStone).multiply(stoneUnitPrice).value
                  : stoneMetersPerPiece * qtyStone * stoneUnitPrice;
                materialItems.push({
                  name: 'Камни (вставки)',
                  size: `h${stoneHeight}×${trimData.width}×${trimData.thickness}`,
                  unit: 'шт',
                  qty: qtyStone,
                  baseLength: stoneHeight,
                  totalLength: stoneTotal * qtyStone,
                  meters: stoneMetersPerPiece * qtyStone,
                  unitPrice: stoneUnitPrice,
                  sum: stoneSum,
                  type: 'material',
                  hasMiter: false,
                  mode: detailModes.trim
                });
              }
            }
          } catch (e) {
            // ignore errors
          }
        }

        // === Обработка наличника и карниза для Типа 3 ===
        if (data.openingType === 'type3') {
          try {
            const A_mm3 = data.openingWidth;
            const B_mm3 = data.openingHeight;
            // Ширина и толщина наличника для типа 3
            let C3_mm = trimData.width;
            let T3_mm = trimData.thickness;
            // Извлекаем ширину и толщину наличника из блока type3 (в случае если выше не установлено)
            const c3Field = document.getElementById('type3_trim_width');
            if (c3Field && c3Field.value) {
              const tmp = parseFloat(c3Field.value);
              if (!isNaN(tmp)) C3_mm = tmp;
            }
            const t3Field = document.getElementById('type3_trim_thickness');
            if (t3Field && t3Field.value) {
              const tmp = parseFloat(t3Field.value);
              if (!isNaN(tmp)) T3_mm = tmp;
            }
            // Толщина и ширина карниза для типа 3
            let CK3_mm = null;
            let CW3_mm = null;
            const ck3Field = document.getElementById('type3_cornice_thickness');
            const cw3Field = document.getElementById('type3_cornice_width');
            if (ck3Field && ck3Field.value) {
              const tmp = parseFloat(ck3Field.value);
              if (!isNaN(tmp)) CK3_mm = tmp;
            }
            if (cw3Field && cw3Field.value) {
              const tmp = parseFloat(cw3Field.value);
              if (!isNaN(tmp)) CW3_mm = tmp;
            }
            // В случае отсутствия значения берём из ручных настроек
            if (!C3_mm || isNaN(C3_mm)) {
              const manualC3 = document.getElementById('manual_trim_width');
              if (manualC3 && manualC3.value) C3_mm = parseFloat(manualC3.value);
            }
            if (!T3_mm || isNaN(T3_mm)) {
              const manualT3 = document.getElementById('manual_trim_thickness');
              if (manualT3 && manualT3.value) T3_mm = parseFloat(manualT3.value);
            }
            if (!CK3_mm || isNaN(CK3_mm)) {
              const manualCK3 = document.getElementById('manual_cornice_thickness');
              if (manualCK3 && manualCK3.value) CK3_mm = parseFloat(manualCK3.value);
            }
            if (!CW3_mm || isNaN(CW3_mm)) {
              const manualCW3 = document.getElementById('manual_cornice_width');
              if (manualCW3 && manualCW3.value) CW3_mm = parseFloat(manualCW3.value);
            }
            // Перегружаем ширину и толщину наличника в trimData на значения типа 3
            if (C3_mm && !isNaN(C3_mm)) trimData.width = C3_mm;
            if (T3_mm && !isNaN(T3_mm)) trimData.thickness = T3_mm;
            // Базовая длина вертикальной стойки: B (без припусков)
            const vertBase3 = B_mm3;
            // Базовая длина карниза: A + 2·C + 10 + 4·D (где D = толщина карниза)
            // Для типа 3 E в формуле Lк = A + 2*C + 10 + 4*D.
            let D3_mm = CK3_mm; // толщина карниза
            if (!D3_mm || isNaN(D3_mm)) D3_mm = 0;
            const corniceBase3 = A_mm3 + 2 * C3_mm + 10 + 4 * D3_mm;
            // Рассчитываем мита и припуски для вертикальных стоек
            const vertMiter3 = trimHasMiter ? calculateAngleMiterAddition(trimData.thickness, trimAngle, data.miterExtra) : 0;
            let vertTotal3 = vertBase3 + vertMiter3 + data.reveal;
            vertTotal3 += vertTotal3 * (wastePercent / 100) + cuttingAllowance;
            const vertMetersPerPiece3 = vertTotal3 / 1000;
            const vertLookup3 = lookupPrice(trimData.width, trimData.thickness);
            const vertPricePerPiece3 = vertMetersPerPiece3 * vertLookup3.p;
            // Рассчитываем мита и припуски для карниза
            const corniceMiter3 = corniceHasMiter ? calculateAngleMiterAddition(D3_mm || trimData.thickness, corniceAngleCut, data.miterExtra) : 0;
            let corniceTotal3 = corniceBase3 + corniceMiter3 + data.reveal;
            corniceTotal3 += corniceTotal3 * (wastePercent / 100) + cuttingAllowance;
            const corniceMetersPerPiece3 = corniceTotal3 / 1000;
            // Используем ширину и толщину карниза (CW3_mm и CK3_mm)
            const corniceLookup3 = lookupPrice(CW3_mm || trimData.width, CK3_mm || trimData.thickness);
            const cornicePricePerPiece3 = corniceMetersPerPiece3 * corniceLookup3.p;
            // Добавляем вертикальные стойки (2 шт на один проём)
            {
              const qty3 = 2 * data.count;
              const totalLength3 = vertTotal3 * qty3;
              const totalMeters3 = vertMetersPerPiece3 * qty3;
              materialItems.push({
                name: `Наличник стойка`,
                size: `h${vertBase3}×${trimData.width}×${trimData.thickness}`,
                unit: 'шт',
                qty: qty3,
                baseLength: vertBase3,
                totalLength: totalLength3,
                meters: totalMeters3,
                unitPrice: vertPricePerPiece3,
                sum: ((typeof currency !== 'undefined') ? currency(vertPricePerPiece3).multiply(qty3).value : vertPricePerPiece3 * qty3),
                type: 'material',
                hasMiter: trimHasMiter,
                mode: detailModes.trim
              });
            }
            // Добавляем карниз (1 шт на один проём)
            {
              const qty3h = 1 * data.count;
              const totalLength3h = corniceTotal3 * qty3h;
              const totalMeters3h = corniceMetersPerPiece3 * qty3h;
              materialItems.push({
                name: `Карниз`,
                size: `h${corniceBase3}×${(CW3_mm || trimData.width)}×${(CK3_mm || trimData.thickness)}`,
                unit: 'шт',
                qty: qty3h,
                baseLength: corniceBase3,
                totalLength: totalLength3h,
                meters: totalMeters3h,
                unitPrice: cornicePricePerPiece3,
                sum: ((typeof currency !== 'undefined') ? currency(cornicePricePerPiece3).multiply(qty3h).value : cornicePricePerPiece3 * qty3h),
                type: 'material',
                hasMiter: corniceHasMiter,
                mode: detailModes.cornice
              });
            }
          } catch (e) {
            // ignore errors
          }
        }
        
        // КАРНИЗ: для типов 1, 2 и 3 cornice не рассчитывается и не добавляется (обрабатывается отдельно)
        if (data.openingType !== 'type1' && data.openingType !== 'type2' && data.openingType !== 'type3') {
          let corniceData, corniceName;
          if (detailModes.cornice === 'auto') {
            const corniceLength = data.openingWidth + (2 * data.trimWidth) + data.gap + data.corniceOverhangLeft + data.corniceOverhangRight;
            corniceData = {
              width: data.corniceWidth,
              thickness: data.corniceThickness,
              height: data.corniceHeight,
              length: corniceLength,
              qty: data.count
            };
            corniceName = `Карниз h${data.corniceHeight}×${data.corniceWidth}×${data.corniceThickness}${corniceHasMiter ? ' с боковыми запилами в сборе' : ''}`;
          } else {
            const manualWidth = parseFloat(document.getElementById('manual_cornice_width').value) || 300;
            const manualThickness = parseFloat(document.getElementById('manual_cornice_thickness').value) || 100;
            const manualHeight = parseFloat(document.getElementById('manual_cornice_height').value) || 150;
            corniceData = {
              width: manualWidth,
              thickness: manualThickness,
              height: manualHeight,
              length: data.openingWidth + 160,
              // Количество умножается на число проёмов
              qty: (parseFloat(document.getElementById('manual_cornice_qty').value) || 1) * data.count
            };
            corniceName = `Карниз h${manualHeight}×${manualWidth}×${manualThickness}${corniceHasMiter ? ' с боковыми запилами в сборе' : ''} (ручной)`;
          }
          const corniceMiterAdd = corniceHasMiter ? calculateAngleMiterAddition(corniceData.thickness, corniceAngle, data.miterExtra) : 0;
          let corniceTotalLength = corniceData.length + corniceMiterAdd + data.reveal;
          const corniceWasteAdd = corniceTotalLength * (wastePercent / 100);
          corniceTotalLength += corniceWasteAdd + cuttingAllowance;
          const corniceLookup = lookupPrice(corniceData.width, corniceData.thickness);
          const corniceMeters = corniceTotalLength / 1000;
          const corniceSum = (typeof currency !== 'undefined')
            ? currency(corniceMeters).multiply(corniceData.qty).multiply(corniceLookup.p).value
            : corniceData.qty * corniceMeters * corniceLookup.p;
          // Для типа 1 карниз не используется. Добавляем карниз только если это не тип 1.
          if (data.openingType !== 'type1') {
            materialItems.push({
              name: corniceName,
              size: `h${corniceData.height}×${corniceData.width}×${corniceData.thickness}`,
              unit: 'мп',
              qty: corniceData.qty,
              baseLength: corniceData.length,
              totalLength: corniceTotalLength,
              meters: corniceMeters,
              unitPrice: corniceLookup.p,
              sum: corniceSum,
              type: 'material',
              hasMiter: corniceHasMiter,
              mode: detailModes.cornice
            });
          }
        }
        
        // ПОДОКОННИК (для окна и типов 1, 2, 3)
// Для типов окна и 1–5 добавляем подоконник
if (data.openingType === 'window' || data.openingType === 'type1' || data.openingType === 'type2' || data.openingType === 'type3' || data.openingType === 'type4' || data.openingType === 'type5') {
          let sillData, sillName;
          if (detailModes.sill === 'auto') {
            const sillLength = data.openingWidth + (2 * data.trimWidth) + data.gap + data.sillOverhangLeft + data.sillOverhangRight;
            sillData = {
              width: data.sillWidth,
              thickness: data.sillThickness,
              depth: data.sillDepth,
              length: sillLength,
              qty: data.count
            };
            sillName = `Подоконник h${data.sillThickness}×${data.sillWidth}×${data.sillDepth}${sillHasMiter ? ' с боковыми запилами в сборе' : ''}`;
          } else {
            const manualWidth = parseFloat(document.getElementById('manual_sill_width').value) || 300;
            const manualThickness = parseFloat(document.getElementById('manual_sill_thickness').value) || 120;
            const manualDepth = parseFloat(document.getElementById('manual_sill_depth').value) || 200;
            sillData = {
              width: manualWidth,
              thickness: manualThickness,
              depth: manualDepth,
              length: data.openingWidth + 160,
              // Количество умножается на число проёмов
              qty: (parseFloat(document.getElementById('manual_sill_qty').value) || 1) * data.count
            };
            sillName = `Подоконник h${manualThickness}×${manualWidth}×${manualDepth}${sillHasMiter ? ' с боковыми запилами в сборе' : ''} (ручной)`;
          }

          // === Коррекция длины и толщины подоконника для типа 1 ===
          if (data.openingType === 'type1' || data.openingType === 'type4' || data.openingType === 'type5') {
            try {
              const A_mm = data.openingWidth;
              // C: ширина наличника для типа 1, 4, 5
              let C_mm = null;
              if (data.openingType === 'type4') {
                const cField = document.getElementById('type4_trim_width');
                if (cField && cField.value) {
                  const tmp = parseFloat(cField.value);
                  if (!isNaN(tmp)) C_mm = tmp;
                }
              } else if (data.openingType === 'type5') {
                const cField = document.getElementById('type5_trim_width');
                if (cField && cField.value) {
                  const tmp = parseFloat(cField.value);
                  if (!isNaN(tmp)) C_mm = tmp;
                }
              } else {
                const cField = document.getElementById('type1_trim_width');
                if (cField && cField.value) {
                  C_mm = parseFloat(cField.value);
                }
              }
              if (!C_mm || isNaN(C_mm)) {
                const manualCEl = document.getElementById('manual_trim_width');
                if (manualCEl && manualCEl.value) {
                  const tmp = parseFloat(manualCEl.value);
                  if (!isNaN(tmp)) C_mm = tmp;
                }
              }
              // E: толщина подоконника для типа 1, 4, 5
              let E_mm = null;
              if (data.openingType === 'type4') {
                const eField = document.getElementById('type4_sill_thickness');
                if (eField && eField.value) {
                  const tmp = parseFloat(eField.value);
                  if (!isNaN(tmp)) E_mm = tmp;
                }
              } else if (data.openingType === 'type5') {
                const eField = document.getElementById('type5_sill_thickness');
                if (eField && eField.value) {
                  const tmp = parseFloat(eField.value);
                  if (!isNaN(tmp)) E_mm = tmp;
                }
              } else {
                const eField = document.getElementById('type1_sill_thickness');
                if (eField && eField.value) {
                  E_mm = parseFloat(eField.value);
                }
              }
              if (!E_mm || isNaN(E_mm)) {
                const manualEEl = document.getElementById('manual_sill_thickness');
                if (manualEEl && manualEEl.value) {
                  const tmp = parseFloat(manualEEl.value);
                  if (!isNaN(tmp)) E_mm = tmp;
                }
              }
              if (C_mm && E_mm && !isNaN(C_mm) && !isNaN(E_mm)) {
                // Для типа 1 подоконник рассчитывается по формуле A + 2·C + 4·E
                // (без фиксированного припуска 10 мм) — т.е. припуск по 2·E с каждой стороны
                const Lp_mm = A_mm + 2 * C_mm + 4 * E_mm;
                // корректируем длину и толщину подоконника
                sillData.length = Lp_mm;
                sillData.thickness = E_mm;
                // ширина подоконника: берём из соответствующего поля типа или из ручных настроек
                let W_mm = null;
                if (data.openingType === 'type4') {
                  const wField = document.getElementById('type4_sill_width');
                  if (wField && wField.value) {
                    const tmp = parseFloat(wField.value);
                    if (!isNaN(tmp)) W_mm = tmp;
                  }
                } else if (data.openingType === 'type5') {
                  const wField = document.getElementById('type5_sill_width');
                  if (wField && wField.value) {
                    const tmp = parseFloat(wField.value);
                    if (!isNaN(tmp)) W_mm = tmp;
                  }
                } else {
                  const wField = document.getElementById('type1_sill_width');
                  if (wField && wField.value) {
                    W_mm = parseFloat(wField.value);
                  }
                }
                if (!W_mm || isNaN(W_mm)) {
                  const manualSW = document.getElementById('manual_sill_width');
                  if (manualSW && manualSW.value) {
                    const tmp = parseFloat(manualSW.value);
                    if (!isNaN(tmp)) W_mm = tmp;
                  }
                }
                if (W_mm && !isNaN(W_mm)) {
                  sillData.width = W_mm;
                }
                // обновляем имя подоконника, чтобы отражать новые размеры
                sillName = `Подоконник h${sillData.thickness}×${sillData.width}×${sillData.depth}${sillHasMiter ? ' с боковыми запилами в сборе' : ''}`;
              }
            } catch (e) {
              // ignore errors
            }
          }

          // === Коррекция длины и толщины подоконника для типа 2 ===
          if (data.openingType === 'type2') {
            try {
              const A_mm2 = data.openingWidth;
              // C: ширина наличника для типа 2
              let C_mm2 = null;
              const c2Field = document.getElementById('type2_trim_width');
              if (c2Field && c2Field.value) {
                C_mm2 = parseFloat(c2Field.value);
              }
              if (!C_mm2 || isNaN(C_mm2)) {
                const manualCEl2 = document.getElementById('manual_trim_width');
                if (manualCEl2 && manualCEl2.value) {
                  C_mm2 = parseFloat(manualCEl2.value);
                }
              }
              // E: толщина подоконника для типа 2
              let E_mm2 = null;
              const e2Field = document.getElementById('type2_sill_thickness');
              if (e2Field && e2Field.value) {
                E_mm2 = parseFloat(e2Field.value);
              }
              if (!E_mm2 || isNaN(E_mm2)) {
                const manualEEl2 = document.getElementById('manual_sill_thickness');
                if (manualEEl2 && manualEEl2.value) {
                  E_mm2 = parseFloat(manualEEl2.value);
                }
              }
              if (C_mm2 && E_mm2 && !isNaN(C_mm2) && !isNaN(E_mm2)) {
                const Lp_mm2 = A_mm2 + 2 * C_mm2 + 10 + 2 * E_mm2;
                sillData.length = Lp_mm2;
                sillData.thickness = E_mm2;
                // Ширина подоконника берётся из поля type2_sill_width или из ручных настроек
                let W_mm2 = null;
                const w2Field = document.getElementById('type2_sill_width');
                if (w2Field && w2Field.value) {
                  W_mm2 = parseFloat(w2Field.value);
                }
                if (!W_mm2 || isNaN(W_mm2)) {
                  const manualSW2 = document.getElementById('manual_sill_width');
                  if (manualSW2 && manualSW2.value) {
                    W_mm2 = parseFloat(manualSW2.value);
                  }
                }
                if (W_mm2 && !isNaN(W_mm2)) {
                  sillData.width = W_mm2;
                }
                // Обновляем имя подоконника, чтобы отражать новые размеры для типа 2
                sillName = `Подоконник h${sillData.thickness}×${sillData.width}×${sillData.depth}${sillHasMiter ? ' с боковыми запилами в сборе' : ''}`;
              }
            } catch (e) {
              // ignore errors
            }
          }
          
          const sillMiterAdd = sillHasMiter ? calculateAngleMiterAddition(sillData.thickness, sillAngleCut, data.miterExtra) : 0;
          let sillTotalLength = sillData.length + sillMiterAdd + data.reveal;
          
          // Добавляем припуски
          const sillWasteAdd = sillTotalLength * (wastePercent / 100);
          sillTotalLength += sillWasteAdd + cuttingAllowance;
          
          const sillLookup = lookupPrice(sillData.width, sillData.thickness);
          const sillMeters = sillTotalLength / 1000;
          const sillSum = (typeof currency !== 'undefined')
            ? currency(sillMeters).multiply(sillData.qty).multiply(sillLookup.p).value
            : sillData.qty * sillMeters * sillLookup.p;
          
          materialItems.push({
            name: sillName,
            size: `h${sillData.thickness}×${sillData.width}×${sillData.depth}`,
            unit: 'мп',
            qty: sillData.qty,
            baseLength: sillData.length,
            totalLength: sillTotalLength,
            meters: sillMeters,
            unitPrice: sillLookup.p,
            sum: sillSum,
            type: 'material',
            hasMiter: sillHasMiter,
            mode: detailModes.sill
          });
        }

        // === ДОБАВЛЕНИЕ СТРОК ДЛЯ ВЫБРАННОГО ТИПА ОКНА ===
        // Если выбран тип окна и определены значения Lн/Lп/Lо, добавляем их как отдельные позиции
        try {
          const wtKey = window.selectedWindowType;
          const wtValues = window.windowTypeValues;
          const wtDefs = window.windowTypes;
          // Добавляем строки только для типа окна, если тип выбран и это окно
        // Отключаем добавление отдельных строк Lн/Lп/Lо для типа 1.  Условие всегда ложно.
        if (false && data.openingType === 'type1' && wtKey && wtValues && wtDefs && wtDefs[wtKey]) {
            const wt = wtDefs[wtKey];
            const wtName = wt.name || wtKey;
            // Lо – длина обрамления (всегда добавляем)
            materialItems.unshift({
              name: `Тип ${wtName}: Lо – длина обрамления`,
              size: '—',
              unit: 'мм',
              qty: 1,
              baseLength: wtValues.Lo,
              totalLength: wtValues.Lo,
              meters: wtValues.Lo / 1000,
              unitPrice: 0,
              sum: 0,
              type: 'windowtype',
              hasMiter: false,
              mode: 'auto'
            });
            // Lп – длина подоконника (добавляем только если тип предусматривает подоконник)
            if (wt.includeSill) {
              materialItems.unshift({
                name: `Тип ${wtName}: Lп – длина подоконника`,
                size: '—',
                unit: 'мм',
                qty: 1,
                baseLength: wtValues.Lp,
                totalLength: wtValues.Lp,
                meters: wtValues.Lp / 1000,
                unitPrice: 0,
                sum: 0,
                type: 'windowtype',
                hasMiter: false,
                mode: 'auto'
              });
            }
            // Lн – длина наличника (всегда добавляем)
            materialItems.unshift({
              name: `Тип ${wtName}: Lн – длина наличника`,
              size: '—',
              unit: 'мм',
              qty: 1,
              baseLength: wtValues.Ln,
              totalLength: wtValues.Ln,
              meters: wtValues.Ln / 1000,
              unitPrice: 0,
              sum: 0,
              type: 'windowtype',
              hasMiter: false,
              mode: 'auto'
            });
          }
        } catch(e) {
          // Если глобальные объекты недоступны – ничего не добавляем
        }
        
        // РАСЧЁТ РАБОТ
        if (includeMounting) {
          const totalLinearMeters = materialItems.reduce((sum, item) => sum + (item.meters * item.qty), 0);
          const finalMountingPrice = mountingPrice * workComplexity * heightFactor * accessFactor;
          const mountingCost = (typeof currency !== 'undefined')
            ? currency(totalLinearMeters).multiply(finalMountingPrice).value
            : totalLinearMeters * finalMountingPrice;
          
          workItems.push({
            name: '🔧 Погонный монтаж',
            size: '—',
            unit: 'мп',
            qty: 1,
            baseLength: 0,
            totalLength: 0,
            meters: totalLinearMeters,
            unitPrice: finalMountingPrice,
            sum: mountingCost,
            type: 'work'
          });
        }
        
        // Откосы
        if (includeSlopes) {
          const slopesMeters = (data.openingHeight * 2 + data.openingWidth) / 1000 * data.count;
          const finalSlopesPrice = slopesPrice * workComplexity * heightFactor * accessFactor;
          const slopesCost = (typeof currency !== 'undefined')
            ? currency(slopesMeters).multiply(finalSlopesPrice).value
            : slopesMeters * finalSlopesPrice;
          
          workItems.push({
            name: '🏗️ Погонные откосы - три стороны',
            size: '—',
            unit: 'мп',
            qty: data.count,
            baseLength: 0,
            totalLength: 0,
            meters: slopesMeters,
            unitPrice: finalSlopesPrice,
            sum: slopesCost,
            type: 'work'
          });
        }
        
        // Штучные работы
        if (includePieceWork) {
          const finalPieceWorkPrice = pieceWorkPrice * workComplexity * heightFactor * accessFactor;
          const pieceWorkCost = (typeof currency !== 'undefined')
            ? currency(data.count).multiply(finalPieceWorkPrice).value
            : data.count * finalPieceWorkPrice;
          
          workItems.push({
            name: '📦 Штучные работы',
            size: '—',
            unit: 'шт',
            qty: data.count,
            baseLength: 0,
            totalLength: 0,
            meters: 0,
            unitPrice: finalPieceWorkPrice,
            sum: pieceWorkCost,
            type: 'work'
          });
        }
        
        /*
         * Добавляем отдельные строки для камней и кронштейнов
         * для типов 4 и 5 непосредственно перед выводом сметы.
         * Расчёт выполняется здесь, чтобы гарантировать, что
         * дополнительные позиции попадут в массив materialItems
         * и будут обработаны вместе с остальными материалами.
         */
        try {
          // Добавляем камни и кронштейны только для типов 4 и 5
          if (data.openingType === 'type4' || data.openingType === 'type5') {
            // Определяем ширину (C) и толщину (T) наличника
            let C_extra = 0;
            let T_extra = 0;
            const cFieldExtra = document.getElementById(`${data.openingType}_trim_width`);
            if (cFieldExtra && cFieldExtra.value) {
              const tmp = parseFloat(cFieldExtra.value);
              if (!isNaN(tmp)) C_extra = tmp;
            }
            const tFieldExtra = document.getElementById(`${data.openingType}_trim_thickness`);
            if (tFieldExtra && tFieldExtra.value) {
              const tmp = parseFloat(tFieldExtra.value);
              if (!isNaN(tmp)) T_extra = tmp;
            }
            // Если значения не заданы, берём из ручных настроек
            if (!C_extra || isNaN(C_extra)) {
              const mC = document.getElementById('manual_trim_width');
              if (mC && mC.value) {
                const tmp = parseFloat(mC.value);
                if (!isNaN(tmp)) C_extra = tmp;
              }
            }
            if (!T_extra || isNaN(T_extra)) {
              const mT = document.getElementById('manual_trim_thickness');
              if (mT && mT.value) {
                const tmp = parseFloat(mT.value);
                if (!isNaN(tmp)) T_extra = tmp;
              }
            }
            // Читаем высоту камня F и кронштейна G
            let F_extra = 0;
            let G_extra = 0;
            if (data.openingType === 'type4') {
              const f4 = document.getElementById('type4_stone_height');
              if (f4 && f4.value) {
                const tmp = parseFloat(f4.value);
                if (!isNaN(tmp)) F_extra = tmp;
              }
            } else if (data.openingType === 'type5') {
              const f5 = document.getElementById('type5_stone_height');
              if (f5 && f5.value) {
                const tmp = parseFloat(f5.value);
                if (!isNaN(tmp)) F_extra = tmp;
              }
              const g5 = document.getElementById('type5_bracket_height');
              if (g5 && g5.value) {
                const tmp = parseFloat(g5.value);
                if (!isNaN(tmp)) G_extra = tmp;
              }
            }
            // Получаем цену за погонный метр наличника для расчёта стоимости
            let priceLookup = { p: 0 };
            try {
              priceLookup = lookupPrice(C_extra, T_extra) || { p: 0 };
            } catch (e) {
              priceLookup = { p: 0 };
            }
            // Добавляем камни (вставки), если задана высота F
            if (F_extra > 0) {
              let stoneTotalLen = F_extra + data.reveal;
              stoneTotalLen += stoneTotalLen * (wastePercent / 100) + cuttingAllowance;
              const stoneQty = 2 * data.count;
              // Используем толщину и ставку из полей типа
              let volTcm = 8;
              let rateVol = 50000;
              if (data.openingType === 'type4') {
                const vt = document.getElementById('type4_stone_thickness_cm');
                const rt = document.getElementById('type4_stone_rate');
                const vtVal = parseFloat(vt?.value);
                const rtVal = parseFloat(rt?.value);
                if (!isNaN(vtVal)) volTcm = vtVal;
                if (!isNaN(rtVal)) rateVol = rtVal;
              } else if (data.openingType === 'type5') {
                const vt = document.getElementById('type5_stone_thickness_cm');
                const rt = document.getElementById('type5_stone_rate');
                const vtVal = parseFloat(vt?.value);
                const rtVal = parseFloat(rt?.value);
                if (!isNaN(vtVal)) volTcm = vtVal;
                if (!isNaN(rtVal)) rateVol = rtVal;
              }
              // Объём одной вставки: (длина с припуском/1000) * (ширина C/1000) * (толщина см/100)
              const stoneVolPerPiece = (stoneTotalLen / 1000) * (C_extra / 1000) * (volTcm / 100);
              const stoneVol = stoneVolPerPiece * stoneQty;
              const stoneUnitPrice = rateVol;
              const stoneSum = stoneVol * stoneUnitPrice;
              materialItems.push({
                name: 'Камни (вставки)',
                size: `h${F_extra}×${C_extra}×${(volTcm * 10).toFixed(0)}`,
                unit: 'м³',
                qty: stoneQty,
                baseLength: F_extra,
                totalLength: stoneTotalLen * stoneQty,
                meters: stoneVol,
                unitPrice: stoneUnitPrice,
                sum: stoneSum,
                type: 'material',
                hasMiter: false,
                mode: detailModes.trim
              });
            }
            // Добавляем кронштейны (вставки) для типа 5
            if (data.openingType === 'type5' && G_extra > 0) {
              let bracketTotalLen = G_extra + data.reveal;
              bracketTotalLen += bracketTotalLen * (wastePercent / 100) + cuttingAllowance;
              const bracketQty = 2 * data.count;
              // Используем толщину и ставку из типа5
              let volTcm2 = 8;
              let rateVol2 = 50000;
              {
                const vt2 = document.getElementById('type5_stone_thickness_cm');
                const rt2 = document.getElementById('type5_stone_rate');
                const vtVal2 = parseFloat(vt2?.value);
                const rtVal2 = parseFloat(rt2?.value);
                if (!isNaN(vtVal2)) volTcm2 = vtVal2;
                if (!isNaN(rtVal2)) rateVol2 = rtVal2;
              }
              const bracketVolPerPiece = (bracketTotalLen / 1000) * (C_extra / 1000) * (volTcm2 / 100);
              const bracketVol = bracketVolPerPiece * bracketQty;
              const bracketUnitPrice = rateVol2;
              const bracketSum = bracketVol * bracketUnitPrice;
              materialItems.push({
                name: 'Кронштейны (вставки)',
                size: `h${G_extra}×${C_extra}×${(volTcm2 * 10).toFixed(0)}`,
                unit: 'м³',
                qty: bracketQty,
                baseLength: G_extra,
                totalLength: bracketTotalLen * bracketQty,
                meters: bracketVol,
                unitPrice: bracketUnitPrice,
                sum: bracketSum,
                type: 'material',
                hasMiter: false,
                mode: detailModes.trim
              });
            }
          }
        } catch (insExtra) {
          // При ошибках вставок продолжаем без дополнительных строк
        }

        // Для типов 4 и 5 убеждаемся, что камни и кронштейны добавлены как отдельные позиции.
        try {
          if (data && (data.openingType === 'type4' || data.openingType === 'type5')) {
            // Определяем ширину и толщину наличника для расчёта цен
            let cVal = trimData?.width || 0;
            let tVal = trimData?.thickness || 0;
            // Из блока конкретного типа 4/5
            const cField = document.getElementById(`${data.openingType}_trim_width`);
            if (cField && cField.value) {
              const tmp = parseFloat(cField.value);
              if (!isNaN(tmp)) cVal = tmp;
            }
            const tField = document.getElementById(`${data.openingType}_trim_thickness`);
            if (tField && tField.value) {
              const tmp = parseFloat(tField.value);
              if (!isNaN(tmp)) tVal = tmp;
            }
            // fallback на ручные значения
            if ((!cVal || isNaN(cVal)) && document.getElementById('manual_trim_width')?.value) {
              const tmp = parseFloat(document.getElementById('manual_trim_width').value);
              if (!isNaN(tmp)) cVal = tmp;
            }
            if ((!tVal || isNaN(tVal)) && document.getElementById('manual_trim_thickness')?.value) {
              const tmp = parseFloat(document.getElementById('manual_trim_thickness').value);
              if (!isNaN(tmp)) tVal = tmp;
            }
            // Высоты камня и кронштейна
            let F_ins = 0;
            let G_ins = 0;
            if (data.openingType === 'type4') {
              const f4 = document.getElementById('type4_stone_height');
              if (f4 && f4.value) {
                const tmp = parseFloat(f4.value);
                if (!isNaN(tmp)) F_ins = tmp;
              }
            } else if (data.openingType === 'type5') {
              const f5 = document.getElementById('type5_stone_height');
              if (f5 && f5.value) {
                const tmp = parseFloat(f5.value);
                if (!isNaN(tmp)) F_ins = tmp;
              }
              const g5 = document.getElementById('type5_bracket_height');
              if (g5 && g5.value) {
                const tmp = parseFloat(g5.value);
                if (!isNaN(tmp)) G_ins = tmp;
              }
            }
            const priceInfo = lookupPrice(cVal, tVal) || { p: 0 };
            const pMeter = priceInfo.p || 0;
            // Проверяем наличие камней
            if (F_ins > 0) {
              const hasStone = materialItems.some(it => it.name === 'Камни (вставки)');
              if (!hasStone) {
                // длина одной вставки с учётом припуска и отходов
                let total = F_ins + data.reveal;
                total += total * (wastePercent / 100) + cuttingAllowance;
                const metersPerPiece = total / 1000;
                const qtyIns = 2 * data.count;
                const unitPrice = (typeof currency !== 'undefined')
                  ? currency(metersPerPiece).multiply(pMeter).value
                  : metersPerPiece * pMeter;
                const sumIns = (typeof currency !== 'undefined')
                  ? currency(metersPerPiece).multiply(qtyIns).multiply(pMeter).value
                  : metersPerPiece * qtyIns * pMeter;
                materialItems.push({
                  name: 'Камни (вставки)',
                  size: `h${F_ins}×${cVal}×${tVal}`,
                  unit: 'шт',
                  qty: qtyIns,
                  baseLength: F_ins,
                  totalLength: total * qtyIns,
                  meters: metersPerPiece * qtyIns,
                  unitPrice: unitPrice,
                  sum: sumIns,
                  type: 'material',
                  hasMiter: false,
                  mode: detailModes.trim
                });
              }
            }
            // Проверяем наличие кронштейнов для типа 5
            if (data.openingType === 'type5' && G_ins > 0) {
              const hasBracket = materialItems.some(it => it.name === 'Кронштейны (вставки)');
              if (!hasBracket) {
                let total = G_ins + data.reveal;
                total += total * (wastePercent / 100) + cuttingAllowance;
                const metersPerPiece = total / 1000;
                const qtyIns = 2 * data.count;
                const unitPrice = (typeof currency !== 'undefined')
                  ? currency(metersPerPiece).multiply(pMeter).value
                  : metersPerPiece * pMeter;
                const sumIns = (typeof currency !== 'undefined')
                  ? currency(metersPerPiece).multiply(qtyIns).multiply(pMeter).value
                  : metersPerPiece * qtyIns * pMeter;
                materialItems.push({
                  name: 'Кронштейны (вставки)',
                  size: `h${G_ins}×${cVal}×${tVal}`,
                  unit: 'шт',
                  qty: qtyIns,
                  baseLength: G_ins,
                  totalLength: total * qtyIns,
                  meters: metersPerPiece * qtyIns,
                  unitPrice: unitPrice,
                  sum: sumIns,
                  type: 'material',
                  hasMiter: false,
                  mode: detailModes.trim
                });
              }
            }
          }
        } catch (insEnsure) {
          // игнорируем ошибки вставок
        }

        // Перед выводом сметы проверяем, чтобы у всех материалов была корректная цена и сумма.
        try {
          materialItems.forEach(item => {
            // Корректируем только материалы (не работы), у которых цена или сумма нулевая
            if (item.type === 'material' && (!item.unitPrice || item.unitPrice === 0 || !item.sum || item.sum === 0)) {
              // Получаем ширину и толщину для определения цены. По умолчанию берём данные trimData.
              let C_mm = trimData?.width || 0;
              let T_mm = trimData?.thickness || 0;
              if (item.size) {
                const parts = item.size.split('×');
                if (parts.length >= 3) {
                  const cVal = parseFloat(parts[1]);
                  const tVal = parseFloat(parts[2]);
                  if (!isNaN(cVal)) C_mm = cVal;
                  if (!isNaN(tVal)) T_mm = tVal;
                }
              }
              const priceInfo = lookupPrice(C_mm, T_mm) || { p: 0 };
              const pricePerMeter = priceInfo.p || 0;
              const totalMeters = item.meters || ((item.totalLength || 0) / 1000);
              const qty = item.qty || 1;
              const metersPerPiece = totalMeters / qty;
              // Цена за штуку рассчитывается как метраж одной детали × цена за метр
              const newUnitPrice = (typeof currency !== 'undefined')
                ? currency(metersPerPiece).multiply(pricePerMeter).value
                : metersPerPiece * pricePerMeter;
              const newSum = (typeof currency !== 'undefined')
                ? currency(totalMeters).multiply(pricePerMeter).value
                : totalMeters * pricePerMeter;
              item.unitPrice = newUnitPrice;
              item.sum = newSum;
            }
          });
        } catch (fixErr) {
          // В случае ошибки просто продолжаем
        }
        showProfessionalResultsWithWork(materialItems, workItems);
        showNotification(`🎯 Профессиональная смета готова — ${materialItems.length + workItems.length} позиций`, 'success');
        
      } catch (error) {
        showNotification('Ошибка при расчёте', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '🧮 Рассчитать смету';
      }
    }

    function calculateAngleMiterAddition(thickness_mm, angle, extra_mm) {
      if (!angle || angle <= 0) return parseFloat(extra_mm || 0);
      const angleRadians = (angle * Math.PI) / 180;
      const miterLength = thickness_mm * Math.tan(angleRadians / 2) * 2;
      return miterLength + parseFloat(extra_mm || 0);
    }

