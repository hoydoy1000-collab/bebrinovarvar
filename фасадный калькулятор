<script>
// --- Begin deduplication and clear project enhancements ---
(function() {
  // Remove duplicate piece items based on original dimensions and price per meter
  function dedupPieceItems() {
    if (!Array.isArray(window.pieceItems)) return;
    const seen = {};
    window.pieceItems = window.pieceItems.filter(function(item) {
      var key;
      if (item.__src) {
        key = item.__src.h_cm + '|' + item.__src.w_cm + '|' + item.__src.t_cm + '|' + item.qty + '|' + item.pricePerM;
      } else {
        key = item.id;
      }
      if (seen[key]) return false;
      seen[key] = true;
      return true;
    });
    try {
      localStorage.setItem('facade_piece_items', JSON.stringify(window.pieceItems));
    } catch (e) {}
    if (typeof window.renderPieceList === 'function') {
      try { window.renderPieceList(); } catch (e) {}
    }
    if (typeof window.saveAppState === 'function') {
      try { window.saveAppState(); } catch (e) {}
    }
  }
  // Attach deduplication before calculating the main estimate
  function attachDedupOnCalc() {
    document.addEventListener('click', function(e) {
      var target = e.target;
      if (!target) return;
      var txt = (target.textContent || '').trim();
      if (/рассчитать\s*смету/i.test(txt)) {
        dedupPieceItems();
      }
    }, true);
  }

  /**
   * Immediately re-render the main estimate to include current piece items without recalculating proёмов.
   * This function rebuilds calculationResults.materialItems by merging existing non-piece items
   * (if any) with all entries from window.pieceItems, computing correct size/lengths/sums
   * and then calls renderAdjustedResults() to update the UI. It does not trigger
   * auto-calculation for proёмов and does not remove global states.
   */
  window.renderPiecesImmediately = function() {
    try {
      // Ensure global pieceItems is an array
      if (!Array.isArray(window.pieceItems)) {
        window.pieceItems = [];
      }
      // Remove any legacy separate pieces smeta section if present
      var ps = document.getElementById('piecesSmetaSection');
      if (ps) {
        try { ps.remove(); } catch (e) { ps.style.display = 'none'; }
      }
      // Create calculationResults if not present
      if (!calculationResults || typeof calculationResults !== 'object') {
        calculationResults = { materialItems: [], workItems: [], materialTotal: 0, workTotal: 0 };
      }
      // Copy existing non-piece items (if any)
      const baseItems = Array.isArray(calculationResults.materialItems)
        ? calculationResults.materialItems.filter(function(it) { return it.type !== 'piece'; })
        : [];
      const newMaterialItems = [];
      // Append base items first
      baseItems.forEach(function(it) { newMaterialItems.push(it); });
      // Build rows for each piece item
      window.pieceItems.forEach(function(piece) {
        const perPieceMm  = Math.round(piece.length * 1000);
        const totalMeters = piece.length * piece.qty;
        // Build size from __src or fallback
        const hMm = piece.__src ? Math.round(piece.__src.h_cm * 10) : perPieceMm;
        const wMm = piece.__src ? Math.round(piece.__src.w_cm * 10) : Math.round(piece.width);
        const tMm = piece.__src ? Math.round(piece.__src.t_cm * 10) : Math.round(piece.thickness);
        const totalSum = piece.pricePerM * totalMeters;
        newMaterialItems.push({
          name: piece.name,
          size: `h${hMm}×${wMm}×${tMm}`,
          unit: 'шт',
          qty: piece.qty,
          baseLength: perPieceMm,
          totalLength: perPieceMm * piece.qty,
          meters: totalMeters,
          unitPrice: piece.pricePerM,
          sum: totalSum,
          type: 'piece',
          hasMiter: false,
          mode: 'manual'
        });
      });
      // Assign back to calculationResults and compute total
      calculationResults.materialItems = newMaterialItems;
      calculationResults.materialTotal = newMaterialItems.reduce(function(acc, it) { return acc + (it.sum || 0); }, 0);
      calculationResults.workItems = [];
      calculationResults.workTotal = 0;
      // Update UI via renderAdjustedResults if available
      if (typeof renderAdjustedResults === 'function') {
        renderAdjustedResults();
      } else if (typeof renderResults === 'function') {
        renderResults(calculationResults);
      }
    } catch (err) {
      // silently ignore errors
    }
  };
  // Clear project data: remove piece items and project list, reset inputs and tables
  function clearProject() {
    if (Array.isArray(window.pieceItems)) window.pieceItems = [];
    if (Array.isArray(window.projectList)) window.projectList = [];
    try {
      localStorage.removeItem('facade_piece_items');
      localStorage.removeItem('facade_project_list');
      localStorage.removeItem('stickModeInputs');
      localStorage.removeItem('stickModeEnabled');
    } catch (e) {}
    if (typeof window.resetForNewObject === 'function') {
      try { window.resetForNewObject(); } catch (e) {}
    }
    if (typeof window.renderPieceList === 'function') {
      try { window.renderPieceList(); } catch (e) {}
    }
    if (typeof window.renderProjectList === 'function') {
      try { window.renderProjectList(); } catch (e) {}
    }
    if (typeof window.calculateAndShow === 'function') {
      try { window.calculateAndShow(); } catch (e) {}
    }
    if (typeof window.showNotification === 'function') {
      try { window.showNotification('Проект очищен', 'success'); } catch (e) {}
    } else {
      alert('Проект очищен');
    }
  
      setTimeout(function(){ window.location.reload(); }, 50);
}
  // Add a Clear Project button to the actions panel
  function initClearButton() {
    var attempt = 0;
    var intv = setInterval(function() {
      var calcBtn = document.getElementById('customCalcBtn');
      if (calcBtn) {
        clearInterval(intv);
        var clearBtn = document.createElement('button');
        clearBtn.id = 'clearProjectBtn';
        clearBtn.textContent = '🧹 Очистить проект';
        clearBtn.className = calcBtn.className || 'button button-danger';
        clearBtn.style.marginLeft = '8px';
