  function findImageForType(id) {
    return new Promise(resolve => {
      let idx = 0;
      const tryNext = () => {
        if (idx >= IMG_EXTS.length) { resolve(PLACEHOLDER); return; }
        const src = `tip${id}.${IMG_EXTS[idx]}`;
        const img = new Image();
        img.onload = () => resolve(src);
        img.onerror = () => { idx++; tryNext(); };
        img.src = src;
      };
      tryNext();
    });
  }

  // Insert or update image banners for each type block (type1_elements_block, type2_elements_block, etc.)
  async function insertTypeBanners() {
    // Loop through all defined types (1–5) and attach a banner to every matching block.
    for (let i = 1; i <= 5; i++) {
      // Find all blocks for this type (in case of duplicate IDs from legacy markup)
      const blocks = document.querySelectorAll(`#type${i}_elements_block`);
      if (!blocks || blocks.length === 0) continue;
      const src = await findImageForType(i);
      blocks.forEach(block => {
        if (!block) return;
        let banner = block.querySelector('.facade-type-banner');
        if (!banner) {
          banner = document.createElement('div');
          banner.className = 'facade-type-banner';
          const img = document.createElement('img');
          img.className = 'facade-type-img';
          const title = document.createElement('div');
          title.className = 'ftb-title';
          banner.appendChild(img);
          banner.appendChild(title);
          // Insert banner at the beginning of the block content if possible.
          const content = block.querySelector('.card-content') || block;
          content.insertBefore(banner, content.firstChild);
        }
        const imgEl = banner.querySelector('img');
        const titleEl = banner.querySelector('.ftb-title');
        imgEl.src = src;
        imgEl.alt = `Тип ${i}`;
        titleEl.textContent = `Тип ${i}`;
        // Click to enlarge
        imgEl.style.cursor = 'zoom-in';
        imgEl.addEventListener('click', () => openLightbox(imgEl.src));
