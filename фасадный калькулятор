            html: `
              <div class="grid grid-2" style="gap: 12px;">
                <div class="form-group"><label class="form-label">A — ширина (мм)</label><input id="areaA" type="number" class="swal2-input" value="${defaultA}" min="1" step="1"></div>
                <div class="form-group"><label class="form-label">B — высота (мм)</label><input id="areaB" type="number" class="swal2-input" value="${defaultB}" min="1" step="1"></div>
