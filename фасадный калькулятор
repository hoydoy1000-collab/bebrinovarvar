        document.getElementById('trim_has_miter').checked = true;
        document.getElementById('cornice_has_miter').checked = true;
        document.getElementById('sill_has_miter').checked = true;
        document.getElementById('trim_angle').value = 45;
        document.getElementById('cornice_angle').value = 45;
        document.getElementById('sill_angle_cut').value = 45;
        // обновим м/запилы
        updateMiterInputs();
        // пересчёт автоматических размеров
        autoCalculateAll();
        updateDefaultQtyOverrides();
