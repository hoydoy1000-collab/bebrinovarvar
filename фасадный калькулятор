/**
 * Пересчитывает смету для группы «Руст», перезаписывая секцию и футер.
 * Принимает массив объектов areaItems.
 */
function renderAreaSmeta(items){
  const table = document.querySelector('#resultsTable');
  const tbody = table ? table.querySelector('tbody') : null;
  if (!tbody) return;
  // Удаляем прежние элементы группы «Руст»
  tbody.querySelectorAll('tr.__area__').forEach(tr => tr.remove());
  // Удаляем стандартную заглушку, если она присутствует
